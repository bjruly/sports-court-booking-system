<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0"><diagram name="C4 - Mức 1 System Context" id="pg0"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Khách hàng&lt;br&gt;[Người dùng]&lt;br&gt;Tìm sân, đặt sân, thanh toán,&lt;br&gt;hủy, đánh giá" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#E6F3EA;strokeColor=#2E7D4F;fontSize=11;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="239" height="86" as="geometry"/></mxCell><mxCell id="n3" value="Chủ sân&lt;br&gt;[Người dùng]&lt;br&gt;Quản lý cơ sở, sân, giá,&lt;br&gt;lịch đặt, doanh thu" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#E6F3EA;strokeColor=#2E7D4F;fontSize=11;" vertex="1" parent="1"><mxGeometry x="275" y="0" width="204" height="86" as="geometry"/></mxCell><mxCell id="n4" value="Quản trị viên&lt;br&gt;[Người dùng]&lt;br&gt;Duyệt cơ sở, quản lý người dùng,&lt;br&gt;thống kê toàn hệ thống" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#E6F3EA;strokeColor=#2E7D4F;fontSize=11;" vertex="1" parent="1"><mxGeometry x="515" y="0" width="260" height="86" as="geometry"/></mxCell><mxCell id="n5" value="Hệ thống đặt sân thể thao&lt;br&gt;[Software System]&lt;br&gt;Tìm sân – đặt sân – thanh toán – quản lý" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#2E7D4F;strokeColor=#2E7D4F;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="219" y="147" width="316" height="69" as="geometry"/></mxCell><mxCell id="n6" value="Cổng thanh toán&lt;br&gt;(VNPay / MoMo)&lt;br&gt;[Hệ thống ngoài]" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#777777;fontSize=11;" vertex="1" parent="1"><mxGeometry x="108" y="288" width="148" height="69" as="geometry"/></mxCell><mxCell id="n7" value="Dịch vụ Email / SMS&lt;br&gt;[Hệ thống ngoài]" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#777777;fontSize=11;" vertex="1" parent="1"><mxGeometry x="293" y="296" width="169" height="52" as="geometry"/></mxCell><mxCell id="n8" value="Dịch vụ bản đồ&lt;br&gt;(OpenStreetMap / Google Maps)&lt;br&gt;[Hệ thống ngoài]" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#777777;fontSize=11;" vertex="1" parent="1"><mxGeometry x="498" y="288" width="239" height="69" as="geometry"/></mxCell><mxCell id="e9" value="Sử dụng (web/mobile)" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=10;" edge="1" parent="1" source="n2" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="Quản lý cơ sở" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=10;" edge="1" parent="1" source="n3" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="Quản trị" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=10;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="Tạo giao dịch,&lt;br&gt;nhận kết quả (IPN)" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=10;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="Gửi xác nhận,&lt;br&gt;nhắc lịch" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=10;" edge="1" parent="1" source="n5" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="Hiển thị vị trí,&lt;br&gt;tính khoảng cách" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=10;" edge="1" parent="1" source="n5" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>