@using SportsCourtBooking.Application.DTOs
@model ChangePasswordRequest

@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<section class="page-section">
    <div class="shell shell--narrow">

        <div class="page-heading">
            <div>
                <h1>Đổi mật khẩu</h1>
                <p class="page-subtitle">
                    Nhập mật khẩu hiện tại và mật khẩu mới của bạn.
                </p>
            </div>
        </div>

        <div class="review-card">
            <form class="account-form"
                  asp-controller="Account"
                  asp-action="ChangePassword"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="selection-error">
                </div>

                <label asp-for="CurrentPassword">
                    Mật khẩu hiện tại
                </label>

                <input asp-for="CurrentPassword"
                       type="password"
                       value=""
                       autocomplete="current-password"
                       maxlength="100"
                       required />

                <span asp-validation-for="CurrentPassword"
                      class="selection-error">
                </span>

                <label asp-for="NewPassword">
                    Mật khẩu mới
                </label>

                <input asp-for="NewPassword"
                       type="password"
                       value=""
                       autocomplete="new-password"
                       minlength="8"
                       maxlength="100"
                       required />

                <span asp-validation-for="NewPassword"
                      class="selection-error">
                </span>

                <label asp-for="ConfirmPassword">
                    Nhập lại mật khẩu mới
                </label>

                <input asp-for="ConfirmPassword"
                       type="password"
                       value=""
                       autocomplete="new-password"
                       minlength="8"
                       maxlength="100"
                       required />

                <span asp-validation-for="ConfirmPassword"
                      class="selection-error">
                </span>

                <p>Mật khẩu mới phải từ 8 đến 100 ký tự.</p>

                <button class="button button--primary"
                        type="submit">
                    Đổi mật khẩu
                </button>

                <a class="text-link"
                   asp-controller="Account"
                   asp-action="Profile">
                    Quay lại hồ sơ cá nhân
                </a>
            </form>
        </div>

    </div>
</section>