@model AccountPrototypeViewModel

@{
    ViewData["Title"] = "Tạo tài khoản";
}

<section class="account-section">
    <div class="shell account-shell">
        <div class="account-aside">
            <p class="eyebrow"><span class="eyebrow-line"></span> TÀI KHOẢN SÂN NHÀ</p>
            <h1>Hội bạn đủ rồi.<br /><em>Thiếu sân thôi.</em></h1>
            <p>Tạo tài khoản để sẵn sàng cho trận đấu tiếp theo.</p>
            <div class="account-aside-mark" aria-hidden="true">S<span>.</span></div>
        </div>
        <div class="account-card">
            <p class="eyebrow eyebrow--dark"><span class="eyebrow-line"></span> THAM GIA CÙNG CHÚNG MÌNH</p>
            <h2>Tạo tài khoản</h2>
            <p class="account-subtitle">Điền thông tin để bắt đầu.</p>

            <form class="account-form" asp-controller="Auth" asp-action="Register" method="post">
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <label for="fullName">Họ và tên</label>
                <input id="fullName" name="FullName" type="text" autocomplete="name" maxlength="100" placeholder="Tên của bạn" required />
                <label for="email">Email</label>
                <input id="email" name="Email" type="email" autocomplete="email" maxlength="150" placeholder="ban@example.com" required />
                <label for="phoneNumber">Số điện thoại</label>
                <input id="phoneNumber" name="PhoneNumber" type="tel" autocomplete="tel" inputmode="tel" placeholder="0901234567" required />
                <label for="password">Mật khẩu (tối thiểu 8 ký tự)</label>
                <input id="password" name="Password" type="password" autocomplete="new-password" minlength="8" maxlength="100" placeholder="Tạo mật khẩu" required />
                <label for="confirmPassword">Nhập lại mật khẩu</label>
                <input id="confirmPassword" name="ConfirmPassword" type="password" autocomplete="new-password" minlength="8" maxlength="100" placeholder="Nhập lại mật khẩu" required />
                <button class="button button--primary button--full" type="submit">Tạo tài khoản <span aria-hidden="true">→</span></button>
            </form>
            <p class="account-switch">Đã có tài khoản? <a asp-controller="Home" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">Đăng nhập</a></p>
            <a class="account-back" asp-controller="Home" asp-action="Index">← Quay lại tìm sân</a>
        </div>
    </div>
</section>
