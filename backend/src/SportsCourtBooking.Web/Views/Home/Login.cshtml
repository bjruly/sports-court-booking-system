@model AccountPrototypeViewModel

@{
    ViewData["Title"] = "Đăng nhập";
}

<section class="account-section">
    <div class="shell account-shell">
        <div class="account-aside">
            <p class="eyebrow"><span class="eyebrow-line"></span> TÀI KHOẢN SÂN NHÀ</p>
            <h1>Trận vui<br />đang chờ <em>bạn.</em></h1>
            <p>Đăng nhập để tiếp tục hành trình đặt sân.</p>
            <div class="account-aside-mark" aria-hidden="true">S<span>.</span></div>
        </div>
        <div class="account-card">
            <p class="eyebrow eyebrow--dark"><span class="eyebrow-line"></span> CHÀO MỪNG TRỞ LẠI</p>
            <h2>Đăng nhập</h2>
            <p class="account-subtitle">Vui lòng đăng nhập để tiếp tục đặt sân.</p>

            <div class="notice notice--prototype" role="status">
                <span class="notice-symbol" aria-hidden="true">i</span>
                <span>Giao diện đăng nhập đang ở bước prototype. ASP.NET Core Identity chưa được kết nối.</span>
            </div>

            <form class="account-form">
                <label for="email">Email</label>
                <input id="email" type="email" autocomplete="email" placeholder="ban@example.com" />
                <label for="password">Mật khẩu</label>
                <input id="password" type="password" autocomplete="current-password" placeholder="Nhập mật khẩu" />
                <button class="button button--primary button--full" type="button" disabled>Đăng nhập <span aria-hidden="true">→</span></button>
            </form>
            <p class="account-switch">Chưa có tài khoản? <a asp-controller="Home" asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">Tạo tài khoản</a></p>
            <a class="account-back" asp-controller="Home" asp-action="Index">← Quay lại tìm sân</a>
        </div>
    </div>
</section>
