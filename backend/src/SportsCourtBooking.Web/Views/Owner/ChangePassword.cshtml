@model SportsCourtBooking.Web.Models.OwnerChangePasswordViewModel

@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<section class="admin-page">
    <div class="shell admin-layout">
        @await Html.PartialAsync("_Sidebar")

        <div class="admin-content">
            <header class="admin-page-heading">
                <div>
                    <p class="eyebrow eyebrow--dark"><span class="eyebrow-line"></span> TÀI KHOẢN CHỦ SÂN</p>
                    <h1>Đổi mật khẩu</h1>
                    <p class="page-subtitle">Xác nhận mật khẩu hiện tại để bảo vệ tài khoản của bạn.</p>
                </div>
            </header>

            <section class="admin-status-card owner-profile-card">
                <form asp-action="ChangePassword" method="post" class="owner-profile-form">
                    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

                    <div class="owner-profile-fields">
                        <div class="form-group">
                            <label asp-for="CurrentPassword">Mật khẩu hiện tại</label>
                            <input asp-for="CurrentPassword" class="form-control" type="password"
                                   autocomplete="current-password" maxlength="100" />
                        </div>

                        <div class="form-group">
                            <label asp-for="NewPassword">Mật khẩu mới</label>
                            <input asp-for="NewPassword" class="form-control" type="password"
                                   autocomplete="new-password" maxlength="100" />
                            <small class="owner-profile-hint">Sử dụng từ 8 đến 100 ký tự.</small>
                        </div>

                        <div class="form-group">
                            <label asp-for="ConfirmPassword">Xác nhận mật khẩu mới</label>
                            <input asp-for="ConfirmPassword" class="form-control" type="password"
                                   autocomplete="new-password" maxlength="100" />
                        </div>
                    </div>

                    <div class="owner-profile-actions">
                        <a asp-action="Profile" class="button button--outline">Hủy</a>
                        <button class="button button--primary" type="submit">Cập nhật mật khẩu</button>
                    </div>
                </form>
            </section>
        </div>
    </div>
</section>
