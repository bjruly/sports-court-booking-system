@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var isCourtManagement = currentAction is "Courts" or "CreateCourt" or "EditCourt";
    var isCourtList = currentAction is "Courts" or "EditCourt";
    var isBookingManagement = currentAction == "Bookings";
}

<aside class="admin-sidebar" aria-label="Menu Chủ Sân">
    <div class="admin-sidebar-heading">
        <span class="admin-sidebar-brand">SÂN NHÀ <span>CHỦ SÂN</span></span>
        <p>Xin chào, @User.Identity?.Name</p>
    </div>

    <nav class="admin-sidebar-menu">
        <details class="admin-menu-group" open>
            <summary>Tổng quan</summary>
            <div class="admin-submenu">
                <a class="admin-menu-item @(currentAction == "Index" ? "admin-menu-item--active" : string.Empty)"
                   asp-controller="Owner" asp-action="Index"
                   aria-current="@(currentAction == "Index" ? "page" : null)">Bảng điều khiển</a>
                <span class="admin-menu-item admin-menu-item--disabled" aria-disabled="true"><span>Thống kê sân</span><small>Chưa triển khai</small></span>
                <a class="admin-menu-item @(isBookingManagement ? "admin-menu-item--active" : string.Empty)"
                   asp-controller="Owner" asp-action="Bookings"
                   aria-current="@(isBookingManagement ? "page" : null)">Đơn đặt</a>
                <span class="admin-menu-item admin-menu-item--disabled" aria-disabled="true"><span>Doanh thu</span><small>Chưa triển khai</small></span>
            </div>
        </details>

        <details class="admin-menu-group">
            <summary>Quản lý cơ sở</summary>
            <div class="admin-submenu">
                <span class="admin-menu-item admin-menu-item--disabled" aria-disabled="true"><span>Danh sách cơ sở</span><small>Chưa triển khai</small></span>
                <span class="admin-menu-item admin-menu-item--disabled" aria-disabled="true"><span>Thêm cơ sở</span><small>Chưa triển khai</small></span>
                <span class="admin-menu-item admin-menu-item--disabled" aria-disabled="true"><span>Sửa cơ sở</span><small>Chưa triển khai</small></span>
            </div>
        </details>

        <details class="admin-menu-group" open="@(isCourtManagement ? "open" : null)">
            <summary>Quản lý sân</summary>
            <div class="admin-submenu">
                <a class="admin-menu-item @(isCourtList ? "admin-menu-item--active" : string.Empty)"
                   asp-controller="Owner" asp-action="Courts"
                   aria-current="@(isCourtList ? "page" : null)">Danh sách sân</a>
                <a class="admin-menu-item @(currentAction == "CreateCourt" ? "admin-menu-item--active" : string.Empty)"
                   asp-controller="Owner" asp-action="CreateCourt"
                   aria-current="@(currentAction == "CreateCourt" ? "page" : null)">Thêm sân</a>
            </div>
        </details>

        <details class="admin-menu-group" open="@(isBookingManagement ? "open" : null)">
            <summary>Quản lý đặt sân</summary>
            <div class="admin-submenu">
                <a class="admin-menu-item @(isBookingManagement ? "admin-menu-item--active" : string.Empty)"
                   asp-controller="Owner" asp-action="Bookings"
                   aria-current="@(isBookingManagement ? "page" : null)">Danh sách đơn</a>
                <span class="admin-menu-item admin-menu-item--disabled"><span>Xác nhận / hủy đơn</span><small>Trong danh sách</small></span>
            </div>
        </details>

        <details class="admin-menu-group">
            <summary>Lịch sân</summary>
            <div class="admin-submenu">
                <span class="admin-menu-item admin-menu-item--disabled" aria-disabled="true"><span>Xem lịch</span><small>Chưa triển khai</small></span>
                <span class="admin-menu-item admin-menu-item--disabled" aria-disabled="true"><span>Đặt hộ khách</span><small>Chưa triển khai</small></span>
                <span class="admin-menu-item admin-menu-item--disabled" aria-disabled="true"><span>Check-in</span><small>Chưa triển khai</small></span>
            </div>
        </details>

        <details class="admin-menu-group">
            <summary>Quản lý bảng giá</summary>
            <div class="admin-submenu">
                <span class="admin-menu-item admin-menu-item--disabled" aria-disabled="true"><span>Thiết lập giá theo khung giờ</span><small>Chưa triển khai</small></span>
            </div>
        </details>

        <details class="admin-menu-group">
            <summary>Quản lý voucher</summary>
            <div class="admin-submenu">
                <span class="admin-menu-item admin-menu-item--disabled" aria-disabled="true"><span>Tạo voucher</span><small>Chưa triển khai</small></span>
                <span class="admin-menu-item admin-menu-item--disabled" aria-disabled="true"><span>Sửa voucher</span><small>Chưa triển khai</small></span>
                <span class="admin-menu-item admin-menu-item--disabled" aria-disabled="true"><span>Xóa voucher</span><small>Chưa triển khai</small></span>
            </div>
        </details>

        <details class="admin-menu-group">
            <summary>Đánh giá</summary>
            <div class="admin-submenu">
                <span class="admin-menu-item admin-menu-item--disabled" aria-disabled="true"><span>Xem đánh giá</span><small>Chưa triển khai</small></span>
                <span class="admin-menu-item admin-menu-item--disabled" aria-disabled="true"><span>Phản hồi</span><small>Chưa triển khai</small></span>
            </div>
        </details>

        <details class="admin-menu-group">
            <summary>Báo cáo</summary>
            <div class="admin-submenu">
                <span class="admin-menu-item admin-menu-item--disabled" aria-disabled="true"><span>Báo cáo doanh thu</span><small>Chưa triển khai</small></span>
            </div>
        </details>

        <details class="admin-menu-group">
            <summary>Tài khoản</summary>
            <div class="admin-submenu">
                <span class="admin-menu-item admin-menu-item--disabled" aria-disabled="true"><span>Hồ sơ cá nhân</span><small>Chưa triển khai</small></span>
                <span class="admin-menu-item admin-menu-item--disabled" aria-disabled="true"><span>Đổi mật khẩu</span><small>Chưa triển khai</small></span>
            </div>
        </details>
    </nav>
</aside>
