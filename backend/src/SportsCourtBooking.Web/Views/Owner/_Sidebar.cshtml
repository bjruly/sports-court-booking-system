@using SportsCourtBooking.Application.Common
@using SportsCourtBooking.Domain.Enums
@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var isCourtManagement = currentAction is "Courts" or "CreateCourt" or "EditCourt";
    var isCourtList = currentAction is "Courts" or "EditCourt";
    var isPricingManagement = currentAction is "Pricing" or "EditCourt";
    var isVoucherManagement = currentAction is "Vouchers" or "CreateVoucher" or "EditVoucher";
    var isReviewManagement = currentAction is "Reviews" or "ReplyToReview";
    var isRevenueReport = currentAction == "RevenueReport";
    var isTodayCheckInView = currentAction == "Bookings"
        && ViewContext.HttpContext.Request.Query["date"] == VietnamClock.Today.ToString("yyyy-MM-dd")
        && ViewContext.HttpContext.Request.Query["status"] == BookingStatus.Confirmed.ToString();
    var isBookingManagement = currentAction == "Bookings" && !isTodayCheckInView;
    var isCalendarManagement = currentAction is "Calendar" or "CreateWalkInBooking" || isTodayCheckInView;
}

<aside class="admin-sidebar" aria-label="Menu Chủ Sân">
    <div class="admin-sidebar-heading">
        <span class="admin-sidebar-brand">SÂN NHÀ <span>CHỦ SÂN</span></span>
        <p>Xin chào, @User.Identity?.Name</p>
    </div>

    <nav class="admin-sidebar-menu">
        <details class="admin-menu-group" open>
            <summary>Tổng quan</summary>
            <div class="admin-submenu">
                <a class="admin-menu-item @(currentAction == "Index" ? "admin-menu-item--active" : string.Empty)"
                   asp-controller="Owner" asp-action="Index"
                   aria-current="@(currentAction == "Index" ? "page" : null)">Bảng điều khiển</a>
                <span class="admin-menu-item admin-menu-item--disabled" aria-disabled="true"><span>Thống kê sân</span><small>Chưa triển khai</small></span>
                <a class="admin-menu-item @(isBookingManagement ? "admin-menu-item--active" : string.Empty)"
                   asp-controller="Owner" asp-action="Bookings"
                   aria-current="@(isBookingManagement ? "page" : null)">Đơn đặt</a>
                <a class="admin-menu-item @(isRevenueReport ? "admin-menu-item--active" : string.Empty)"
                   asp-controller="Owner" asp-action="RevenueReport"
                   aria-current="@(isRevenueReport ? "page" : null)">Doanh thu</a>
            </div>
        </details>

        <details class="admin-menu-group">
            <summary>Quản lý cơ sở</summary>
            <div class="admin-submenu">
                <span class="admin-menu-item admin-menu-item--disabled" aria-disabled="true"><span>Danh sách cơ sở</span><small>Chưa triển khai</small></span>
                <span class="admin-menu-item admin-menu-item--disabled" aria-disabled="true"><span>Thêm cơ sở</span><small>Chưa triển khai</small></span>
                <span class="admin-menu-item admin-menu-item--disabled" aria-disabled="true"><span>Sửa cơ sở</span><small>Chưa triển khai</small></span>
            </div>
        </details>

        <details class="admin-menu-group" open="@(isCourtManagement ? "open" : null)">
            <summary>Quản lý sân</summary>
            <div class="admin-submenu">
                <a class="admin-menu-item @(isCourtList ? "admin-menu-item--active" : string.Empty)"
                   asp-controller="Owner" asp-action="Courts"
                   aria-current="@(isCourtList ? "page" : null)">Danh sách sân</a>
                <a class="admin-menu-item @(currentAction == "CreateCourt" ? "admin-menu-item--active" : string.Empty)"
                   asp-controller="Owner" asp-action="CreateCourt"
                   aria-current="@(currentAction == "CreateCourt" ? "page" : null)">Thêm sân</a>
            </div>
        </details>

        <details class="admin-menu-group" open="@(isBookingManagement ? "open" : null)">
            <summary>Quản lý đặt sân</summary>
            <div class="admin-submenu">
                <a class="admin-menu-item @(isBookingManagement ? "admin-menu-item--active" : string.Empty)"
                   asp-controller="Owner" asp-action="Bookings"
                   aria-current="@(isBookingManagement ? "page" : null)">Danh sách đơn</a>
                <span class="admin-menu-item admin-menu-item--disabled"><span>Xác nhận / hủy đơn</span><small>Trong danh sách</small></span>
            </div>
        </details>

        <details class="admin-menu-group" open="@(isCalendarManagement ? "open" : null)">
            <summary>Lịch sân</summary>
            <div class="admin-submenu">
                <a class="admin-menu-item @(currentAction == "Calendar" ? "admin-menu-item--active" : string.Empty)"
                   asp-controller="Owner" asp-action="Calendar"
                   aria-current="@(currentAction == "Calendar" ? "page" : null)">Xem lịch</a>
                <a class="admin-menu-item @(currentAction == "CreateWalkInBooking" ? "admin-menu-item--active" : string.Empty)"
                   asp-controller="Owner" asp-action="CreateWalkInBooking"
                   aria-current="@(currentAction == "CreateWalkInBooking" ? "page" : null)">Đặt hộ khách</a>
                <a class="admin-menu-item @(isTodayCheckInView ? "admin-menu-item--active" : string.Empty)"
                   asp-controller="Owner" asp-action="Bookings"
                   asp-route-date="@VietnamClock.Today.ToString("yyyy-MM-dd")"
                   asp-route-status="@BookingStatus.Confirmed"
                   aria-current="@(isTodayCheckInView ? "page" : null)">Check-in hôm nay</a>
            </div>
        </details>

        <details class="admin-menu-group" open="@(isPricingManagement ? "open" : null)">
            <summary>Quản lý bảng giá</summary>
            <div class="admin-submenu">
                <a class="admin-menu-item @(currentAction == "Pricing" ? "admin-menu-item--active" : string.Empty)"
                   asp-controller="Owner" asp-action="Pricing"
                   aria-current="@(currentAction == "Pricing" ? "page" : null)">Giá theo khung giờ</a>
            </div>
        </details>

        <details class="admin-menu-group" open="@(isVoucherManagement ? "open" : null)">
            <summary>Quản lý voucher</summary>
            <div class="admin-submenu">
                <a class="admin-menu-item @(currentAction == "Vouchers" || currentAction == "EditVoucher" ? "admin-menu-item--active" : string.Empty)"
                   asp-controller="Owner" asp-action="Vouchers"
                   aria-current="@(currentAction == "Vouchers" ? "page" : null)">Danh sách voucher</a>
                <a class="admin-menu-item @(currentAction == "CreateVoucher" ? "admin-menu-item--active" : string.Empty)"
                   asp-controller="Owner" asp-action="CreateVoucher"
                   aria-current="@(currentAction == "CreateVoucher" ? "page" : null)">Tạo voucher</a>
            </div>
        </details>

        <details class="admin-menu-group" open="@(isReviewManagement ? "open" : null)">
            <summary>Đánh giá</summary>
            <div class="admin-submenu">
                <a class="admin-menu-item @(isReviewManagement ? "admin-menu-item--active" : string.Empty)"
                   asp-controller="Owner" asp-action="Reviews"
                   aria-current="@(isReviewManagement ? "page" : null)">Xem đánh giá / phản hồi</a>
            </div>
        </details>

        <details class="admin-menu-group" open="@(isRevenueReport ? "open" : null)">
            <summary>Báo cáo</summary>
            <div class="admin-submenu">
                <a class="admin-menu-item @(isRevenueReport ? "admin-menu-item--active" : string.Empty)"
                   asp-controller="Owner" asp-action="RevenueReport"
                   aria-current="@(isRevenueReport ? "page" : null)">Báo cáo doanh thu</a>
            </div>
        </details>

        <details class="admin-menu-group">
            <summary>Tài khoản</summary>
            <div class="admin-submenu">
                <span class="admin-menu-item admin-menu-item--disabled" aria-disabled="true"><span>Hồ sơ cá nhân</span><small>Chưa triển khai</small></span>
                <span class="admin-menu-item admin-menu-item--disabled" aria-disabled="true"><span>Đổi mật khẩu</span><small>Chưa triển khai</small></span>
            </div>
        </details>
    </nav>
</aside>
