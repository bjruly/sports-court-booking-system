@using System.Globalization
@using SportsCourtBooking.Application.DTOs
@using SportsCourtBooking.Domain.Enums
@using SportsCourtBooking.Web.Models
@model List<CourtDto>

@{
    ViewData["Title"] = "Quản lý sân";
    var culture = CultureInfo.GetCultureInfo("vi-VN");
}

<section class="admin-page">
    <div class="shell admin-layout">
        @await Html.PartialAsync("_Sidebar")

        <div class="admin-content">
            <header class="admin-page-heading owner-list-heading">
                <div>
                    <p class="eyebrow eyebrow--dark"><span class="eyebrow-line"></span> QUẢN LÝ SÂN</p>
                    <h1>Danh sách sân</h1>
                    <p class="page-subtitle">Quản lý thông tin và tình trạng các sân thuộc tài khoản của bạn.</p>
                </div>
                <a class="button button--primary" asp-action="CreateCourt">+ Thêm sân</a>
            </header>

            <section class="admin-status-card admin-status-card--block">
                <p class="admin-section-label">@Model.Count SÂN</p>
                @if (Model.Count == 0)
                {
                    <div class="empty-state owner-courts-empty" role="status">
                        <span class="empty-state-icon" aria-hidden="true">▦</span>
                        <h3>Chưa có sân nào</h3>
                        <p>Thêm sân đầu tiên để bắt đầu quản lý hoạt động của bạn.</p>
                        <a class="button button--small button--dark" asp-action="CreateCourt">Thêm sân</a>
                    </div>
                }
                else
                {
                    <div class="table-wrapper">
                        <table class="data-table owner-courts-table">
                            <thead>
                                <tr>
                                    <th>Tên sân</th>
                                    <th>Môn thể thao</th>
                                    <th>Địa điểm</th>
                                    <th class="text-right">Giá / giờ</th>
                                    <th>Trạng thái</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var court in Model)
                                {
                                    <tr>
                                        <td><strong>@court.Name</strong></td>
                                        <td>@court.CourtTypeName</td>
                                        <td>@court.Location</td>
                                        <td class="text-right">@court.PricePerHour.ToString("N0", culture) đ</td>
                                        <td><span class="status-badge @CourtStatusDisplay.CssClass(court.Status)">@CourtStatusDisplay.Label(court.Status)</span></td>
                                        <td>
                                            <div class="owner-court-actions">
                                                <a class="text-link" asp-action="EditCourt" asp-route-id="@court.Id">Sửa</a>
                                                <form asp-action="UpdateCourtStatus" asp-route-id="@court.Id" method="post" class="owner-status-form">
                                                    <label class="sr-only" for="status-@court.Id">Trạng thái sân @court.Name</label>
                                                    <select id="status-@court.Id" name="status" class="filter-input">
                                                        @foreach (var status in Enum.GetValues<CourtStatus>())
                                                        {
                                                            <option value="@status" selected="@(status == court.Status)">@CourtStatusDisplay.Label(status)</option>
                                                        }
                                                    </select>
                                                    <button class="button button--small button--outline" type="submit">Cập nhật</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        </div>
    </div>
</section>
