@using System.Globalization
@using SportsCourtBooking.Application.DTOs
@using SportsCourtBooking.Domain.Enums
@using SportsCourtBooking.Web.Models
@model OwnerCourtsViewModel

@{
    ViewData["Title"] = "Quản lý sân theo cơ sở";
    var culture = CultureInfo.GetCultureInfo("vi-VN");
}

<section class="admin-page">
    <div class="shell admin-layout">
        @await Html.PartialAsync("_Sidebar")

        <div class="admin-content">
            <header class="admin-page-heading owner-list-heading">
                <div>
                    <p class="eyebrow eyebrow--dark"><span class="eyebrow-line"></span> QUẢN LÝ SÂN THEO CƠ SỞ</p>
                    <h1>Danh sách sân theo cơ sở</h1>
                    <p class="page-subtitle">Tìm kiếm theo cơ sở để xem và quản lý sân, sửa thông tin, khóa sân bảo trì hoặc ngừng hoạt động.</p>
                </div>
                <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                    <a class="button button--outline" asp-action="CreateFacility">+ Đăng ký cơ sở mới</a>
                    <a class="button button--primary" asp-action="CreateCourt">+ Thêm sân tùy chỉnh</a>
                </div>
            </header>

            <!-- 4 Thẻ KPI Thống Kê Tổng Quan -->
            <div class="admin-kpi-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px;">
                <div class="admin-kpi-card" style="background: rgba(30, 41, 59, 0.7); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; padding: 18px 20px;">
                    <p style="font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-muted); margin: 0 0 6px;">Tổng cơ sở</p>
                    <h3 style="font-size: 28px; font-weight: 800; margin: 0; color: #38bdf8;">@Model.TotalFacilities <span style="font-size: 14px; font-weight: 500; color: var(--color-muted);">cơ sở</span></h3>
                </div>
                <div class="admin-kpi-card" style="background: rgba(30, 41, 59, 0.7); border: 1px solid rgba(34, 197, 94, 0.2); border-radius: 12px; padding: 18px 20px;">
                    <p style="font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-muted); margin: 0 0 6px;">Sân đang hoạt động</p>
                    <h3 style="font-size: 28px; font-weight: 800; margin: 0; color: #4ade80;">@Model.TotalActiveCourts <span style="font-size: 14px; font-weight: 500; color: var(--color-muted);">/ @Model.TotalCourts sân</span></h3>
                </div>
                <div class="admin-kpi-card" style="background: rgba(30, 41, 59, 0.7); border: 1px solid rgba(251, 191, 36, 0.2); border-radius: 12px; padding: 18px 20px;">
                    <p style="font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-muted); margin: 0 0 6px;">Sân đang bảo trì</p>
                    <h3 style="font-size: 28px; font-weight: 800; margin: 0; color: #fbbf24;">@Model.TotalMaintenanceCourts <span style="font-size: 14px; font-weight: 500; color: var(--color-muted);">sân</span></h3>
                </div>
                <div class="admin-kpi-card" style="background: rgba(30, 41, 59, 0.7); border: 1px solid rgba(148, 163, 184, 0.2); border-radius: 12px; padding: 18px 20px;">
                    <p style="font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-muted); margin: 0 0 6px;">Sân ngừng hoạt động</p>
                    <h3 style="font-size: 28px; font-weight: 800; margin: 0; color: #94a3b8;">@Model.TotalInactiveCourts <span style="font-size: 14px; font-weight: 500; color: var(--color-muted);">sân</span></h3>
                </div>
            </div>

            <!-- Thanh tìm kiếm theo cơ sở -->
            <section class="admin-status-card" style="margin-bottom: 24px; padding: 18px 20px; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px;">
                <form method="get" asp-action="Courts" style="display: flex; gap: 12px; flex-wrap: wrap; align-items: center;">
                    <div style="flex: 1; min-width: 260px; position: relative;">
                        <input type="text"
                               name="search"
                               value="@Model.Search"
                               placeholder="🔍 Tìm kiếm theo tên cơ sở, địa chỉ, quận huyện, môn thể thao..."
                               class="filter-input"
                               style="width: 100%; padding: 10px 14px; background: rgba(30, 41, 59, 0.8); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 8px; color: #fff; font-size: 14px;" />
                    </div>
                    <button type="submit" class="button button--primary" style="padding: 10px 20px;">
                        🔍 Tìm kiếm cơ sở
                    </button>
                    @if (!string.IsNullOrWhiteSpace(Model.Search))
                    {
                        <a asp-action="Courts" class="button button--outline" style="padding: 10px 16px;">
                            ✕ Xóa tìm kiếm
                        </a>
                    }
                </form>
                @if (!string.IsNullOrWhiteSpace(Model.Search))
                {
                    <p style="margin: 10px 0 0; font-size: 13px; color: var(--color-muted);">
                        Kết quả tìm kiếm cho: <strong>"@Model.Search"</strong> (Tìm thấy @Model.Facilities.Count cơ sở)
                    </p>
                }
            </section>

            <!-- Danh sách cơ sở -->
            @if (Model.Facilities.Count == 0)
            {
                <section class="admin-status-card admin-status-card--block">
                    <div class="empty-state owner-courts-empty" role="status" style="padding: 48px 20px; text-align: center;">
                        <span class="empty-state-icon" aria-hidden="true" style="font-size: 40px; display: block; margin-bottom: 12px;">🏢</span>
                        <h3>@(string.IsNullOrWhiteSpace(Model.Search) ? "Chưa có cơ sở nào" : "Không tìm thấy cơ sở phù hợp")</h3>
                        <p style="color: var(--color-muted); max-width: 480px; margin: 8px auto 20px;">
                            @(string.IsNullOrWhiteSpace(Model.Search)
                                ? "Đăng ký cơ sở đầu tiên để bắt đầu thêm và quản lý các sân thể thao."
                                : "Thử tìm kiếm với từ khóa khác hoặc bấm 'Xóa tìm kiếm' để xem tất cả cơ sở.")
                        </p>
                        @if (string.IsNullOrWhiteSpace(Model.Search))
                        {
                            <a class="button button--primary" asp-action="CreateFacility">+ Đăng ký cơ sở</a>
                        }
                        else
                        {
                            <a class="button button--outline" asp-action="Courts">Xem tất cả cơ sở</a>
                        }
                    </div>
                </section>
            }
            else
            {
                <div class="facility-list-container" style="display: flex; flex-direction: column; gap: 20px;">
                    @foreach (var item in Model.Facilities)
                    {
                        var fac = item.Facility;
                        var courts = item.Courts;
                        var activeCount = courts.Count(c => c.Status == CourtStatus.Active);
                        var maintCount = courts.Count(c => c.Status == CourtStatus.Maintenance);
                        var inactCount = courts.Count(c => c.Status == CourtStatus.Inactive);

                        <details class="facility-accordion-card" @(item.IsExpanded ? "open" : "")
                                 style="background: rgba(30, 41, 59, 0.7); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; overflow: hidden; transition: all 0.2s ease;">
                            <summary style="padding: 20px 24px; cursor: pointer; list-style: none; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px; user-select: none;">
                                <div style="display: flex; flex-direction: column; gap: 6px; flex: 1; min-width: 280px;">
                                    <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                                        <h2 style="margin: 0; font-size: 18px; font-weight: 700; color: #fff;">
                                            🏢 @fac.Name
                                        </h2>
                                        @if (!string.IsNullOrWhiteSpace(fac.CourtTypeName))
                                        {
                                            <span style="display: inline-block; padding: 3px 10px; border-radius: 6px; font-weight: 700; font-size: 11.5px; background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3);">
                                                @fac.CourtTypeName
                                            </span>
                                        }
                                        @if (!fac.IsApproved)
                                        {
                                            <span style="display: inline-block; padding: 3px 10px; border-radius: 6px; font-weight: 700; font-size: 11.5px; background: rgba(234, 179, 8, 0.15); color: #facc15; border: 1px solid rgba(234, 179, 8, 0.3);">
                                                ⏳ Chờ Admin duyệt
                                            </span>
                                        }
                                        else if (!fac.IsActive)
                                        {
                                            <span style="display: inline-block; padding: 3px 10px; border-radius: 6px; font-weight: 700; font-size: 11.5px; background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3);">
                                                🚫 Đang tạm khóa
                                            </span>
                                        }
                                        else
                                        {
                                            <span style="display: inline-block; padding: 3px 10px; border-radius: 6px; font-weight: 700; font-size: 11.5px; background: rgba(34, 197, 94, 0.15); color: #4ade80; border: 1px solid rgba(34, 197, 94, 0.3);">
                                                ✓ Đang mở đón khách
                                            </span>
                                        }
                                    </div>
                                    <div style="font-size: 13px; color: var(--color-muted); display: flex; flex-wrap: wrap; gap: 14px; align-items: center;">
                                        <span>📍 @fac.Address</span>
                                        <span>⏰ @fac.OpenTime - @fac.CloseTime</span>
                                        @if (!string.IsNullOrWhiteSpace(fac.PhoneNumber))
                                        {
                                            <span>📞 @fac.PhoneNumber</span>
                                        }
                                    </div>
                                </div>

                                <div style="display: flex; align-items: center; gap: 20px; flex-wrap: wrap;">
                                    <!-- Thống kê sân trong cơ sở -->
                                    <div style="text-align: right; min-width: 150px;">
                                        <div style="font-size: 14px; font-weight: 700; color: #fff;">
                                            @courts.Count sân
                                        </div>
                                        <div style="font-size: 12px; margin-top: 3px; display: flex; gap: 8px; justify-content: flex-end;">
                                            <span style="color: #4ade80;">🟢 @activeCount</span>
                                            @if (maintCount > 0)
                                            {
                                                <span style="color: #fbbf24;">🔧 @maintCount</span>
                                            }
                                            @if (inactCount > 0)
                                            {
                                                <span style="color: #94a3b8;">⏸️ @inactCount</span>
                                            }
                                        </div>
                                    </div>

                                    <!-- Nút toggle mở rộng -->
                                    <span class="button button--small button--outline" style="pointer-events: none; font-size: 12px; padding: 6px 14px;">
                                        Bấm để xem sân ▾
                                    </span>
                                </div>
                            </summary>

                            <!-- Nội dung danh sách sân khi click vào cơ sở -->
                            <div style="padding: 20px 24px; border-top: 1px solid rgba(255, 255, 255, 0.08); background: rgba(15, 23, 42, 0.4);">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 12px;">
                                    <div>
                                        <h3 style="margin: 0; font-size: 15px; font-weight: 700; color: #e2e8f0;">
                                            Danh sách các sân thuộc cơ sở: @fac.Name
                                        </h3>
                                        <p style="margin: 3px 0 0; font-size: 12.5px; color: var(--color-muted);">
                                            Khóa sân bảo trì hoặc ngừng hoạt động sẽ lập tức ẩn sân đó khỏi trang đặt của khách hàng.
                                        </p>
                                    </div>
                                    <div style="display: flex; gap: 8px;">
                                        <form asp-action="AddCourtToFacility" asp-route-facilityId="@fac.Id" asp-route-returnAction="Courts" method="post" style="display: inline;">
                                            <button type="submit" class="button button--small button--primary" style="font-size: 12px; padding: 6px 14px;">
                                                + Thêm nhanh 1 sân
                                            </button>
                                        </form>
                                        <a class="button button--small button--outline" asp-action="CreateCourt" asp-route-facilityId="@fac.Id" style="font-size: 12px; padding: 6px 14px;">
                                            + Thêm tùy chỉnh
                                        </a>
                                        <a class="button button--small button--outline" asp-action="EditFacility" asp-route-id="@fac.Id" style="font-size: 12px; padding: 6px 12px;">
                                            ✏️ Sửa cơ sở
                                        </a>
                                    </div>
                                </div>

                                @if (courts.Count == 0)
                                {
                                    <div class="empty-state" style="padding: 28px 16px; text-align: center; background: rgba(30, 41, 59, 0.4); border-radius: 8px;">
                                        <p style="margin: 0 0 12px; color: var(--color-muted);">Cơ sở này hiện chưa có sân nào.</p>
                                        <form asp-action="AddCourtToFacility" asp-route-facilityId="@fac.Id" asp-route-returnAction="Courts" method="post">
                                            <button type="submit" class="button button--small button--primary">+ Thêm sân đầu tiên</button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <div class="table-wrapper" style="overflow-x: auto;">
                                        <table class="data-table" style="width: 100%; border-collapse: separate; border-spacing: 0;">
                                            <thead>
                                                <tr>
                                                    <th style="width: 45px;">#</th>
                                                    <th>Tên sân</th>
                                                    <th>Môn thể thao</th>
                                                    <th class="text-right">Giá thuê / giờ</th>
                                                    <th style="text-align: center; width: 150px;">Trạng thái</th>
                                                    <th style="text-align: right; min-width: 280px;">Thao tác quản lý</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @{ int idx = 1; }
                                                @foreach (var court in courts)
                                                {
                                                    <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
                                                        <td style="color: var(--color-muted); font-size: 13px;">@idx</td>
                                                        <td>
                                                            <strong style="color: #fff; font-size: 14px;">@court.Name</strong>
                                                            @if (!string.IsNullOrWhiteSpace(court.Description))
                                                            {
                                                                <small style="display: block; color: var(--color-muted); font-size: 11.5px; margin-top: 2px;">@court.Description</small>
                                                            }
                                                        </td>
                                                        <td style="font-size: 13px;">@court.CourtTypeName</td>
                                                        <td class="text-right" style="font-size: 13.5px;">
                                                            <strong>@court.PricePerHour.ToString("N0", culture) đ</strong>
                                                            @if (court.PeakSurcharge > 0)
                                                            {
                                                                <small style="display: block; color: #fbbf24; font-size: 11px;">+@court.PeakSurcharge.ToString("N0", culture)đ từ @($"{court.PeakStartHour:00}:00")</small>
                                                            }
                                                        </td>
                                                        <td style="text-align: center;">
                                                            @if (court.Status == CourtStatus.Active)
                                                            {
                                                                <span style="display: inline-block; padding: 4px 10px; border-radius: 6px; font-weight: 700; font-size: 11.5px; background: rgba(34, 197, 94, 0.15); color: #4ade80; border: 1px solid rgba(34, 197, 94, 0.3); white-space: nowrap;">
                                                                    🟢 Đang hoạt động
                                                                </span>
                                                            }
                                                            else if (court.Status == CourtStatus.Maintenance)
                                                            {
                                                                <span style="display: inline-block; padding: 4px 10px; border-radius: 6px; font-weight: 700; font-size: 11.5px; background: rgba(251, 191, 36, 0.15); color: #fbbf24; border: 1px solid rgba(251, 191, 36, 0.3); white-space: nowrap;">
                                                                    🔧 Đang bảo trì
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span style="display: inline-block; padding: 4px 10px; border-radius: 6px; font-weight: 700; font-size: 11.5px; background: rgba(148, 163, 184, 0.15); color: #94a3b8; border: 1px solid rgba(148, 163, 184, 0.3); white-space: nowrap;">
                                                                    ⏸️ Ngừng hoạt động
                                                                </span>
                                                            }
                                                        </td>
                                                        <td style="text-align: right;">
                                                            <div style="display: flex; gap: 6px; justify-content: flex-end; align-items: center; flex-wrap: wrap;">
                                                                <!-- Nút sửa -->
                                                                <a class="button button--small button--outline" asp-action="EditCourt" asp-route-id="@court.Id"
                                                                   style="font-size: 11.5px; padding: 4px 10px; color: #38bdf8; border-color: rgba(56, 189, 248, 0.3);">
                                                                    ✏️ Sửa
                                                                </a>

                                                                <!-- Các nút chuyển trạng thái nhanh -->
                                                                @if (court.Status == CourtStatus.Active)
                                                                {
                                                                    <form asp-action="UpdateCourtStatus" method="post" style="display: inline;">
                                                                        <input type="hidden" name="id" value="@court.Id" />
                                                                        <input type="hidden" name="status" value="@CourtStatus.Maintenance" />
                                                                        <input type="hidden" name="facilityId" value="@fac.Id" />
                                                                        <button type="submit" class="button button--small button--outline"
                                                                                title="Khóa sân bảo trì - Người dùng sẽ không thấy để đặt"
                                                                                style="font-size: 11.5px; padding: 4px 10px; color: #fbbf24; border-color: rgba(251, 191, 36, 0.4); background: rgba(251, 191, 36, 0.08);">
                                                                            🔧 Khóa bảo trì
                                                                        </button>
                                                                    </form>
                                                                    <form asp-action="UpdateCourtStatus" method="post" style="display: inline;">
                                                                        <input type="hidden" name="id" value="@court.Id" />
                                                                        <input type="hidden" name="status" value="@CourtStatus.Inactive" />
                                                                        <input type="hidden" name="facilityId" value="@fac.Id" />
                                                                        <button type="submit" class="button button--small button--outline"
                                                                                title="Ngừng hoạt động sân này"
                                                                                style="font-size: 11.5px; padding: 4px 10px; color: #94a3b8; border-color: rgba(148, 163, 184, 0.4);">
                                                                            ⏸️ Ngừng
                                                                        </button>
                                                                    </form>
                                                                }
                                                                else if (court.Status == CourtStatus.Maintenance)
                                                                {
                                                                    <form asp-action="UpdateCourtStatus" method="post" style="display: inline;">
                                                                        <input type="hidden" name="id" value="@court.Id" />
                                                                        <input type="hidden" name="status" value="@CourtStatus.Active" />
                                                                        <input type="hidden" name="facilityId" value="@fac.Id" />
                                                                        <button type="submit" class="button button--small button--outline"
                                                                                title="Mở sân hoạt động trở lại - Cho phép người dùng đặt sân"
                                                                                style="font-size: 11.5px; padding: 4px 10px; color: #4ade80; border-color: rgba(34, 197, 94, 0.4); background: rgba(34, 197, 94, 0.08);">
                                                                            🟢 Mở hoạt động
                                                                        </button>
                                                                    </form>
                                                                    <form asp-action="UpdateCourtStatus" method="post" style="display: inline;">
                                                                        <input type="hidden" name="id" value="@court.Id" />
                                                                        <input type="hidden" name="status" value="@CourtStatus.Inactive" />
                                                                        <input type="hidden" name="facilityId" value="@fac.Id" />
                                                                        <button type="submit" class="button button--small button--outline"
                                                                                style="font-size: 11.5px; padding: 4px 10px; color: #94a3b8; border-color: rgba(148, 163, 184, 0.4);">
                                                                            ⏸️ Ngừng
                                                                        </button>
                                                                    </form>
                                                                }
                                                                else
                                                                {
                                                                    <form asp-action="UpdateCourtStatus" method="post" style="display: inline;">
                                                                        <input type="hidden" name="id" value="@court.Id" />
                                                                        <input type="hidden" name="status" value="@CourtStatus.Active" />
                                                                        <input type="hidden" name="facilityId" value="@fac.Id" />
                                                                        <button type="submit" class="button button--small button--outline"
                                                                                title="Mở sân hoạt động trở lại"
                                                                                style="font-size: 11.5px; padding: 4px 10px; color: #4ade80; border-color: rgba(34, 197, 94, 0.4); background: rgba(34, 197, 94, 0.08);">
                                                                            🟢 Mở hoạt động
                                                                        </button>
                                                                    </form>
                                                                    <form asp-action="UpdateCourtStatus" method="post" style="display: inline;">
                                                                        <input type="hidden" name="id" value="@court.Id" />
                                                                        <input type="hidden" name="status" value="@CourtStatus.Maintenance" />
                                                                        <input type="hidden" name="facilityId" value="@fac.Id" />
                                                                        <button type="submit" class="button button--small button--outline"
                                                                                title="Khóa sân bảo trì"
                                                                                style="font-size: 11.5px; padding: 4px 10px; color: #fbbf24; border-color: rgba(251, 191, 36, 0.4); background: rgba(251, 191, 36, 0.08);">
                                                                            🔧 Bảo trì
                                                                        </button>
                                                                    </form>
                                                                }
                                                            </div>
                                                        </td>
                                                    </tr>
                                                    idx++;
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                        </details>
                    }

                    <!-- Khối sân chưa gán cơ sở (nếu có) -->
                    @if (Model.UnassignedCourts.Count > 0)
                    {
                        <details class="facility-accordion-card"
                                 style="background: rgba(30, 41, 59, 0.5); border: 1px dashed rgba(255, 255, 255, 0.15); border-radius: 12px; overflow: hidden;">
                            <summary style="padding: 18px 24px; cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center;">
                                <div>
                                    <h3 style="margin: 0; font-size: 16px; font-weight: 700; color: #f1f5f9;">
                                        ⚠️ Sân chưa gán cơ sở (@Model.UnassignedCourts.Count sân)
                                    </h3>
                                    <p style="margin: 4px 0 0; font-size: 12px; color: var(--color-muted);">
                                        Các sân cũ chưa được gắn với cơ sở cụ thể. Bạn có thể vào "Sửa" để gán cơ sở cho sân.
                                    </p>
                                </div>
                                <span class="button button--small button--outline" style="pointer-events: none; font-size: 12px;">Xem sân ▾</span>
                            </summary>
                            <div style="padding: 18px 24px; border-top: 1px solid rgba(255, 255, 255, 0.08); background: rgba(15, 23, 42, 0.4);">
                                <div class="table-wrapper">
                                    <table class="data-table">
                                        <thead>
                                            <tr>
                                                <th>Tên sân</th>
                                                <th>Môn</th>
                                                <th>Địa điểm</th>
                                                <th class="text-right">Giá / giờ</th>
                                                <th style="text-align: center;">Trạng thái</th>
                                                <th style="text-align: right;">Thao tác</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var court in Model.UnassignedCourts)
                                            {
                                                <tr>
                                                    <td><strong>@court.Name</strong></td>
                                                    <td>@court.CourtTypeName</td>
                                                    <td>@court.Location</td>
                                                    <td class="text-right">@court.PricePerHour.ToString("N0", culture) đ</td>
                                                    <td style="text-align: center;">
                                                        <span class="status-badge @CourtStatusDisplay.CssClass(court.Status)">@CourtStatusDisplay.Label(court.Status)</span>
                                                    </td>
                                                    <td style="text-align: right;">
                                                        <a class="button button--small button--primary" asp-action="EditCourt" asp-route-id="@court.Id" style="font-size: 11.5px; padding: 4px 10px;">
                                                            ✏️ Gán cơ sở / Sửa
                                                        </a>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </details>
                    }
                </div>
            }

            <!-- Hướng dẫn đồng bộ -->
            <div style="margin-top: 24px; padding: 16px 20px; background: rgba(56, 189, 248, 0.08); border: 1px solid rgba(56, 189, 248, 0.25); border-radius: 10px; font-size: 13px; color: #bae6fd; line-height: 1.6;">
                <strong style="color: #38bdf8; font-size: 14px;">💡 Hướng dẫn đồng bộ trạng thái sân:</strong>
                <ul style="margin: 8px 0 0 18px; padding: 0;">
                    <li><strong>Tìm kiếm theo cơ sở:</strong> Gõ tên cơ sở hoặc địa chỉ để lọc nhanh cơ sở bạn muốn quản lý.</li>
                    <li><strong>Click vào cơ sở:</strong> Bấm vào hàng cơ sở để mở ra toàn bộ danh sách sân của cơ sở đó.</li>
                    <li><strong>Khóa sân bảo trì (🔧):</strong> Khi sân đang sửa chữa hoặc bảo dưỡng, bấm <strong>"🔧 Khóa bảo trì"</strong>. Sân đó sẽ <strong>hoàn toàn ẩn khỏi trang đặt sân người dùng</strong> ngay lập tức.</li>
                    <li><strong>Ngừng hoạt động (⏸️):</strong> Tạm dừng sân, sân cũng sẽ <strong>ẩn khỏi trang đặt sân người dùng</strong>.</li>
                    <li><strong>Mở hoạt động (🟢):</strong> Bấm <strong>"🟢 Mở hoạt động"</strong> để sân hiển thị trở lại và khách hàng có thể đặt ngay.</li>
                </ul>
            </div>
        </div>
    </div>
</section>
