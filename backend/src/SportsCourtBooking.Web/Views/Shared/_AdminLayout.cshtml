<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b1414" />
    <title>@ViewData["Title"] · Sân Nhà Admin</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-dark.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="admin-dark-body">
    @{
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    }

    <!-- ─── TOP HEADER ─── -->
    <header class="adm-header">
        <a class="adm-brand" asp-controller="Admin" asp-action="Index">
            <span class="adm-brand-logo">S</span>
            <span>SÂN NHÀ.</span>
        </a>

        <div class="adm-search-wrap">
            <span class="adm-search-icon">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
            </span>
            <input type="text"
                   class="adm-search-input"
                   placeholder="Tìm kiếm nhanh... (sân, đơn đặt, khách hàng, ...)" />
            <kbd class="adm-search-kbd">Ctrl + K</kbd>
        </div>

        <div class="adm-header-right">
            <button type="button" class="adm-icon-btn" title="Thông báo" aria-label="Thông báo">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                </svg>
                <span class="adm-notif-dot"></span>
            </button>

            <button type="button" class="adm-icon-btn" title="Giao diện tối" aria-label="Đổi giao diện">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                </svg>
            </button>

            <div class="adm-user-dropdown-wrap">
                <div class="adm-user-profile" id="admUserDropdownToggle" tabindex="0" title="Tài khoản quản trị">
                    <div class="adm-avatar">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                    </div>
                    <div class="adm-user-info">
                        <span class="adm-user-name">@(User.Identity?.Name ?? "Quản Trị Viên")</span>
                        <span class="adm-user-role">Admin</span>
                    </div>
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="var(--d-text-sub)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                </div>

                <div class="adm-user-dropdown-menu">
                    <div class="adm-user-dropdown-header">
                        <div class="adm-user-dropdown-name">@(User.Identity?.Name ?? "Quản Trị Viên")</div>
                        <div class="adm-user-dropdown-email">Vai trò: Quản trị hệ thống</div>
                    </div>
                    <div class="adm-user-dropdown-divider"></div>
                    <form asp-controller="Auth" asp-action="Logout" method="post" style="margin: 0;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="adm-user-dropdown-item adm-user-dropdown-logout">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                <polyline points="16 17 21 12 16 7"></polyline>
                                <line x1="21" y1="12" x2="9" y2="12"></line>
                            </svg>
                            <span>Đăng xuất</span>
                        </button>
                    </form>
                </div>
            </div>

            <!-- Nút đăng xuất trực tiếp góc phải Header -->
            <form asp-controller="Auth" asp-action="Logout" method="post" style="display:inline; margin:0;">
                @Html.AntiForgeryToken()
                <button type="submit" class="adm-header-logout-btn" title="Đăng xuất khỏi hệ thống">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                        <polyline points="16 17 21 12 16 7"></polyline>
                        <line x1="21" y1="12" x2="9" y2="12"></line>
                    </svg>
                    <span>Đăng xuất</span>
                </button>
            </form>
        </div>
    </header>

    <!-- ─── WRAPPER (SIDEBAR + MAIN) ─── -->
    <div class="adm-wrapper">
        <aside class="adm-sidebar">
            <ul class="adm-menu">
                <li>
                    <span class="adm-menu-label">HỆ THỐNG</span>
                    <a class="adm-menu-link @(currentAction == "Index" ? "active" : "")"
                       asp-controller="Admin" asp-action="Index">
                        <span class="adm-menu-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
                                <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
                                <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
                                <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
                            </svg>
                        </span>
                        <span>Tổng quan</span>
                    </a>
                </li>

                <li>
                    <span class="adm-menu-label">NGƯỜI DÙNG</span>
                    <a class="adm-menu-link @(currentAction == "Customers" ? "active" : "")"
                       asp-controller="Admin" asp-action="Customers">
                        <span class="adm-menu-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                <circle cx="9" cy="7" r="4"></circle>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                            </svg>
                        </span>
                        <span>Khách hàng</span>
                    </a>
                </li>

                <li>
                    <span class="adm-menu-label">DANH MỤC</span>
                    <a class="adm-menu-link @(currentAction == "Categories" ? "active" : "")"
                       asp-controller="Admin" asp-action="Categories">
                        <span class="adm-menu-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                                <polyline points="2 17 12 22 22 17"></polyline>
                                <polyline points="2 12 12 17 22 12"></polyline>
                            </svg>
                        </span>
                        <span>Môn thể thao & Loại sân</span>
                    </a>
                </li>

                <li>
                    <span class="adm-menu-label">KIỂM DUYỆT</span>
                    <a class="adm-menu-link @(currentAction == "Reviews" ? "active" : "")"
                       asp-controller="Admin" asp-action="Reviews">
                        <span class="adm-menu-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                            </svg>
                        </span>
                        <span>Xử lý đánh giá</span>
                    </a>
                </li>

                <li>
                    <span class="adm-menu-label">BÁO CÁO THỐNG KÊ</span>
                    <a class="adm-menu-link @(currentAction == "Reports" ? "active" : "")"
                       asp-controller="Admin" asp-action="Reports">
                        <span class="adm-menu-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="18" y1="20" x2="18" y2="10"></line>
                                <line x1="12" y1="20" x2="12" y2="4"></line>
                                <line x1="6" y1="20" x2="6" y2="14"></line>
                            </svg>
                        </span>
                        <span>Báo cáo tổng hợp</span>
                    </a>
                </li>
                <li>
                    <a class="adm-menu-link @(currentAction == "CategoryReport" ? "active" : "")"
                       asp-controller="Admin" asp-action="CategoryReport">
                        <span class="adm-menu-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                                <polyline points="17 6 23 6 23 12"></polyline>
                            </svg>
                        </span>
                        <span>Báo cáo danh mục</span>
                    </a>
                </li>
            </ul>

            <!-- Bottom Promo Card matching image -->
            <div class="adm-sidebar-card">
                <p class="adm-sidebar-card-title">Sân bóng SGU</p>
                <p class="adm-sidebar-card-sub">Thể thao kết nối<br />Cộng đồng</p>
            </div>
        </aside>

        <main class="adm-main">
            @RenderBody()
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
