<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#102a2a" />
    <title>@ViewData["Title"] · Sân Nhà</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="site-header">
        <div class="shell header-inner">
            <a class="brand" asp-controller="Home" asp-action="Index" aria-label="Sân Nhà - Trang chủ">
                <span class="brand-mark" aria-hidden="true">S</span>
                <span>SÂN NHÀ<span class="brand-period">.</span></span>
            </a>
            <nav class="main-nav" aria-label="Điều hướng chính">
                <a asp-controller="Home" asp-action="Index">Tìm sân</a>
                <a asp-controller="Booking" asp-action="My">Lịch đặt của tôi</a>
            </nav>
            <div class="header-actions">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="header-user">Xin chào, <strong>@User.Identity?.Name</strong></span>
                    <form class="inline-form" asp-controller="Auth" asp-action="Logout" method="post">
                        <button class="button button--small button--dark" type="submit">Đăng xuất</button>
                    </form>
                }
                else
                {
                    <a class="header-login" asp-controller="Home" asp-action="Login">Đăng nhập</a>
                    <a class="button button--small button--dark" asp-controller="Home" asp-action="Register">Tạo tài khoản</a>
                }
            </div>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="mobile-account" asp-controller="Booking" asp-action="My" aria-label="Lịch đặt của tôi">Lịch đặt của tôi <span aria-hidden="true">↗</span></a>
            }
            else
            {
                <a class="mobile-account" asp-controller="Home" asp-action="Login" aria-label="Đăng nhập">Vào tài khoản <span aria-hidden="true">↗</span></a>
            }
        </div>
    </header>

    @{
        var flashSuccess = TempData["SuccessMessage"] as string;
        var flashError = TempData["ErrorMessage"] as string;
    }
    @if (!string.IsNullOrEmpty(flashSuccess) || !string.IsNullOrEmpty(flashError))
    {
        <div class="shell flash-stack">
            @if (!string.IsNullOrEmpty(flashSuccess))
            {
                <div class="notice notice--success" role="status">
                    <span class="notice-symbol" aria-hidden="true">✓</span>
                    <span>@flashSuccess</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(flashError))
            {
                <div class="notice notice--error" role="alert">
                    <span class="notice-symbol" aria-hidden="true">!</span>
                    <span>@flashError</span>
                </div>
            }
        </div>
    }

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="shell footer-inner">
            <a class="brand brand--footer" asp-controller="Home" asp-action="Index">
                <span class="brand-mark" aria-hidden="true">S</span>
                <span>SÂN NHÀ<span class="brand-period">.</span></span>
            </a>
            <p>Tìm sân phù hợp. Hẹn nhau ra sân.</p>
            <span class="footer-note">Prototype học phần C# · ASP.NET Core MVC</span>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
