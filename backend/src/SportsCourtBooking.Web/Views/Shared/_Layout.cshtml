<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#102a2a" />
    <title>@ViewData["Title"] · Sân Nhà</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="site-header">
        <div class="shell header-inner">
            <a class="brand" asp-controller="Home" asp-action="Index" aria-label="Sân Nhà - Trang chủ">
                <span class="brand-mark" aria-hidden="true">S</span>
                <span>SÂN NHÀ<span class="brand-period">.</span></span>
            </a>
            <nav class="main-nav" aria-label="Điều hướng chính">
                <a asp-controller="Home" asp-action="Index">Tìm sân</a>
                <a class="nav-muted" asp-controller="Home" asp-action="Login">Lịch đặt của tôi</a>
            </nav>
            <div class="header-actions">
                <a class="header-login" asp-controller="Home" asp-action="Login">Đăng nhập</a>
                <a class="button button--small button--dark" asp-controller="Home" asp-action="Register">Tạo tài khoản</a>
            </div>
            <a class="mobile-account" asp-controller="Home" asp-action="Login" aria-label="Đăng nhập">Vào tài khoản <span aria-hidden="true">↗</span></a>
        </div>
    </header>

    <div class="prototype-banner">
        <span class="prototype-dot" aria-hidden="true"></span>
        <span>GIAO DIỆN BẢN THỬ</span>
        <span class="prototype-divider">·</span>
        <span>Dữ liệu mẫu · Tài khoản và đặt sân chưa kết nối backend</span>
    </div>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="shell footer-inner">
            <a class="brand brand--footer" asp-controller="Home" asp-action="Index">
                <span class="brand-mark" aria-hidden="true">S</span>
                <span>SÂN NHÀ<span class="brand-period">.</span></span>
            </a>
            <p>Tìm sân phù hợp. Hẹn nhau ra sân.</p>
            <span class="footer-note">Prototype học phần C# · ASP.NET Core MVC</span>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
