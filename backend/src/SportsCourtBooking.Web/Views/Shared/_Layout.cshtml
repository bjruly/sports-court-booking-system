<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#102a2a" />
    <title>@ViewData["Title"] · Sân Nhà</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @{
        var isAccountPage = ViewContext.RouteData.Values["controller"]?.ToString() == "Home"
            && ViewContext.RouteData.Values["action"]?.ToString() is "Login" or "Register";
    }
    <header class="site-header">
        <div class="shell header-inner">
            <a class="brand" asp-controller="Home" asp-action="Index" aria-label="Sân Nhà - Trang chủ">
                <span class="brand-mark" aria-hidden="true">S</span>
                <span>SÂN NHÀ<span class="brand-period">.</span></span>
            </a>
            @if (!isAccountPage)
            {
                <nav class="main-nav" aria-label="Điều hướng chính">
                    @if (User.IsInRole("Admin") || User.IsInRole("CourtOwner"))
                    {
                        <a asp-controller="Home" asp-action="Index" target="_blank" rel="noopener noreferrer">Về trang chính</a>
                    }
                    else
                    {
                        <a asp-controller="Home" asp-action="Index">Tìm sân</a>
                        @if (User.IsInRole("Staff"))
                        {
                            <a asp-controller="Booking" asp-action="Index">Quản lý lịch đặt</a>
                        }
                        <a asp-controller="Booking" asp-action="My">Lịch đặt của tôi</a>
                    }
                </nav>
            }
            <div class="header-actions">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <!-- Notification Bell Dropdown -->
                    <div class="cust-notif-dropdown-wrap">
                        <button type="button" class="cust-notif-btn" id="custNotifBtn" title="Thông báo" aria-label="Thông báo" aria-haspopup="true" aria-expanded="false">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                                <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                            </svg>
                            <span class="cust-notif-badge" id="custNotifBadge" style="display: none;">0</span>
                        </button>

                        <div class="cust-notif-dropdown" id="custNotifDropdown" role="menu" aria-label="Danh sách thông báo">
                            <div class="cust-notif-header">
                                <div class="cust-notif-title-wrap">
                                    <span class="cust-notif-title">Thông báo</span>
                                    <span class="cust-notif-pill" id="custNotifPill" style="display: none;">0 mới</span>
                                </div>
                                <button type="button" class="cust-notif-mark-read" id="custMarkAllReadBtn">Đã đọc tất cả</button>
                            </div>
                            <div class="cust-notif-tabs">
                                <button type="button" class="cust-notif-tab active" data-filter="unread" id="custNotifTabUnread">
                                    Chưa đọc (<span id="custNotifTabUnreadCount">0</span>)
                                </button>
                                <button type="button" class="cust-notif-tab" data-filter="all" id="custNotifTabAll">Tất cả</button>
                            </div>
                            <div class="cust-notif-list" id="custNotifList">
                                <div class="cust-notif-empty">Đang tải thông báo...</div>
                            </div>
                            <div class="cust-notif-footer">
                                <a href="@Url.Action("My", "Booking")" class="cust-notif-view-all">Lịch đặt của tôi →</a>
                            </div>
                        </div>
                    </div>

                    @if (!User.IsInRole("CourtOwner"))
                    {
                        <a class="header-login" asp-controller="Account" asp-action="Profile">Hồ sơ cá nhân</a>
                    }
                    <span class="header-user">Xin chào, <strong>@User.Identity?.Name</strong></span>
                    <form class="inline-form" asp-controller="Auth" asp-action="Logout" method="post">
                        <button class="button button--small button--dark" type="submit">Đăng xuất</button>
                    </form>
                }
                else
                {
                    <a class="header-login" asp-controller="Home" asp-action="Login">Đăng nhập</a>
                    <a class="button button--small button--dark" asp-controller="Home" asp-action="Register">Tạo tài khoản</a>
                }
            </div>
            @if (User.Identity?.IsAuthenticated == true)
            {
                if (!User.IsInRole("CourtOwner"))
                {
                    <a class="mobile-account" asp-controller="Account" asp-action="Profile">Hồ sơ</a>
                }
                if (User.IsInRole("Admin"))
                {
                    <a class="mobile-account" asp-controller="Admin" asp-action="Index" aria-label="Trang quản trị">Trang quản trị <span aria-hidden="true">↗</span></a>
                }
                else if (User.IsInRole("CourtOwner"))
                {
                    <a class="mobile-account" asp-controller="Owner" asp-action="Index" aria-label="Trang Chủ Sân">Trang Chủ Sân <span aria-hidden="true">↗</span></a>
                }
                else if (User.IsInRole("Staff"))
                {
                    <a class="mobile-account" asp-controller="Booking" asp-action="Index" aria-label="Quản lý lịch đặt">Quản lý lịch đặt <span aria-hidden="true">↗</span></a>
                }
                else
                {
                    <a class="mobile-account" asp-controller="Booking" asp-action="My" aria-label="Lịch đặt của tôi">Lịch đặt của tôi <span aria-hidden="true">↗</span></a>
                }
            }
            else
            {
                <a class="mobile-account" asp-controller="Home" asp-action="Login" aria-label="Đăng nhập">Vào tài khoản <span aria-hidden="true">↗</span></a>
            }
        </div>
    </header>

    @{
        var flashSuccess = TempData["SuccessMessage"] as string;
        var flashError = TempData["ErrorMessage"] as string;
    }
    @if (!string.IsNullOrEmpty(flashSuccess) || !string.IsNullOrEmpty(flashError))
    {
        <div class="shell flash-stack">
            @if (!string.IsNullOrEmpty(flashSuccess))
            {
                <div class="notice notice--success" role="status">
                    <span class="notice-symbol" aria-hidden="true">✓</span>
                    <span>@flashSuccess</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(flashError))
            {
                <div class="notice notice--error" role="alert">
                    <span class="notice-symbol" aria-hidden="true">!</span>
                    <span>@flashError</span>
                </div>
            }
        </div>
    }

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="shell footer-inner">
            <a class="brand brand--footer" asp-controller="Home" asp-action="Index">
                <span class="brand-mark" aria-hidden="true">S</span>
                <span>SÂN NHÀ<span class="brand-period">.</span></span>
            </a>
            <p>Tìm sân phù hợp. Hẹn nhau ra sân.</p>
            <span class="footer-note">Prototype học phần C# · ASP.NET Core MVC</span>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div id="custNotifToastContainer" class="cust-notif-toast-container"></div>
        <script>
        (function () {
            const notifBtn = document.getElementById('custNotifBtn');
            const notifDropdown = document.getElementById('custNotifDropdown');
            const notifBadge = document.getElementById('custNotifBadge');
            const notifPill = document.getElementById('custNotifPill');
            const notifList = document.getElementById('custNotifList');
            const toastContainer = document.getElementById('custNotifToastContainer');
            const tabUnread = document.getElementById('custNotifTabUnread');
            const tabAll = document.getElementById('custNotifTabAll');
            const tabUnreadCount = document.getElementById('custNotifTabUnreadCount');
            const markAllReadBtn = document.getElementById('custMarkAllReadBtn');

            const STORAGE_KEY = 'sanNha_cust_read_notifications_v1';
            let cachedItems = [];
            let currentFilter = 'unread';
            let isInitialLoad = true;
            let knownItemIds = new Set();

            function playChime() {
                try {
                    const AudioCtx = window.AudioContext || window.webkitAudioContext;
                    if (!AudioCtx) return;
                    const ctx = new AudioCtx();
                    if (ctx.state === 'suspended') {
                        ctx.resume();
                    }
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(587.33, ctx.currentTime);
                    osc.frequency.exponentialRampToValueAtTime(880, ctx.currentTime + 0.12);
                    gain.gain.setValueAtTime(0.001, ctx.currentTime);
                    gain.gain.linearRampToValueAtTime(0.2, ctx.currentTime + 0.04);
                    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.45);
                    osc.connect(gain);
                    gain.connect(ctx.destination);
                    osc.start();
                    osc.stop(ctx.currentTime + 0.46);
                } catch (e) {}
            }

            function showToast(item) {
                if (!toastContainer) return;
                const toast = document.createElement('div');
                toast.className = 'cust-notif-toast';
                let icon = '🔔';
                if (item.title && item.title.includes('hoàn tiền')) icon = '💰';
                else if (item.title && item.title.includes('hủy')) icon = '❌';

                toast.innerHTML = `
                    <div class="cust-notif-icon cust-notif-icon--booking">${icon}</div>
                    <div>
                        <div class="cust-notif-toast-title">${escapeHtml(item.title)}</div>
                        <div class="cust-notif-toast-msg">${escapeHtml(item.message)}</div>
                    </div>
                `;
                toast.addEventListener('click', () => {
                    markAsRead(item.id);
                    if (item.url && item.url !== '#') {
                        window.location.href = item.url;
                    }
                });
                toastContainer.appendChild(toast);
                setTimeout(() => {
                    toast.style.transition = 'all 0.35s ease';
                    toast.style.opacity = '0';
                    toast.style.transform = 'translateY(16px)';
                    setTimeout(() => toast.remove(), 350);
                }, 6000);
            }

            function getReadIds() {
                try {
                    const raw = localStorage.getItem(STORAGE_KEY);
                    return raw ? JSON.parse(raw) : [];
                } catch {
                    return [];
                }
            }

            function markAsRead(id) {
                const list = getReadIds();
                if (!list.includes(id)) {
                    list.push(id);
                    localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
                }
                refreshBadgeUI();
            }

            function markAllAsRead() {
                const list = getReadIds();
                cachedItems.forEach(i => {
                    if (!list.includes(i.id)) list.push(i.id);
                });
                localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
                refreshBadgeUI();
                renderList();
            }

            function refreshBadgeUI() {
                const readIds = getReadIds();
                const unreadCount = cachedItems.filter(i => !readIds.includes(i.id)).length;

                if (notifBadge) {
                    if (unreadCount > 0) {
                        notifBadge.textContent = unreadCount > 99 ? '99+' : unreadCount;
                        notifBadge.style.display = 'inline-flex';
                    } else {
                        notifBadge.style.display = 'none';
                    }
                }

                if (notifPill) {
                    if (unreadCount > 0) {
                        notifPill.textContent = `${unreadCount} mới`;
                        notifPill.style.display = 'inline-block';
                    } else {
                        notifPill.style.display = 'none';
                    }
                }

                if (tabUnreadCount) {
                    tabUnreadCount.textContent = unreadCount;
                }
            }

            function escapeHtml(str) {
                if (!str) return '';
                return String(str)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#039;');
            }

            function renderList() {
                if (!notifList) return;
                const readIds = getReadIds();
                const itemsToRender = currentFilter === 'unread'
                    ? cachedItems.filter(i => !readIds.includes(i.id))
                    : cachedItems;

                if (itemsToRender.length === 0) {
                    if (currentFilter === 'unread' && cachedItems.length > 0) {
                        notifList.innerHTML = '<div class="cust-notif-empty">Bạn đã đọc hết thông báo mới.</div>';
                    } else {
                        notifList.innerHTML = '<div class="cust-notif-empty">Hiện tại không có thông báo nào.</div>';
                    }
                    return;
                }

                notifList.innerHTML = itemsToRender.map(item => {
                    const isUnread = !readIds.includes(item.id);
                    let iconClass = 'cust-notif-icon--booking';
                    let icon = '🔔';
                    if (item.title && item.title.includes('hoàn tiền')) { icon = '💰'; }
                    else if (item.title && item.title.includes('hủy')) { icon = '❌'; }
                    else if (item.type === 'review') { iconClass = 'cust-notif-icon--review'; icon = '⭐'; }

                    return `
                        <div class="cust-notif-item ${isUnread ? 'unread' : 'read-dimmed'}" data-id="${escapeHtml(item.id)}" data-url="${escapeHtml(item.url)}">
                            <div class="cust-notif-icon ${iconClass}">${icon}</div>
                            <div class="cust-notif-body">
                                <div class="cust-notif-item-title">
                                    <span>${escapeHtml(item.title)}</span>
                                    <button type="button" class="cust-notif-dismiss-btn" title="Ẩn thông báo này" data-dismiss-id="${escapeHtml(item.id)}">✕</button>
                                </div>
                                <div class="cust-notif-msg">${escapeHtml(item.message)}</div>
                                <div class="cust-notif-time">${escapeHtml(item.timeAgo)}</div>
                            </div>
                            ${isUnread ? '<div class="cust-notif-unread-dot"></div>' : ''}
                        </div>
                    `;
                }).join('');

                notifList.querySelectorAll('.cust-notif-item').forEach(el => {
                    el.addEventListener('click', function (e) {
                        if (e.target.closest('.cust-notif-dismiss-btn')) return;
                        const id = this.dataset.id;
                        const url = this.dataset.url;
                        if (id) markAsRead(id);
                        if (url && url !== '#') {
                            window.location.href = url;
                        }
                    });
                });

                notifList.querySelectorAll('.cust-notif-dismiss-btn').forEach(btn => {
                    btn.addEventListener('click', function (e) {
                        e.stopPropagation();
                        const id = this.dataset.dismissId;
                        if (id) markAsRead(id);
                        renderList();
                    });
                });
            }

            async function fetchNotifications() {
                try {
                    const res = await fetch('/api/notifications', { credentials: 'same-origin' });
                    if (!res.ok) return;
                    const data = await res.json();
                    if (!data || !data.items) return;

                    cachedItems = data.items;
                    const readIds = getReadIds();
                    let newlyDiscoveredItems = [];

                    if (!isInitialLoad) {
                        data.items.forEach(item => {
                            if (!knownItemIds.has(item.id) && !readIds.includes(item.id)) {
                                newlyDiscoveredItems.push(item);
                            }
                        });
                    }

                    data.items.forEach(item => knownItemIds.add(item.id));
                    refreshBadgeUI();
                    renderList();

                    if (newlyDiscoveredItems.length > 0) {
                        playChime();
                        newlyDiscoveredItems.forEach(showToast);
                    }

                    isInitialLoad = false;
                } catch (err) {
                    console.warn('Lỗi lấy thông báo:', err);
                }
            }

            if (notifBtn && notifDropdown) {
                notifBtn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    const isOpen = notifDropdown.classList.contains('show');
                    if (isOpen) {
                        notifDropdown.classList.remove('show');
                        notifBtn.setAttribute('aria-expanded', 'false');
                    } else {
                        notifDropdown.classList.add('show');
                        notifBtn.setAttribute('aria-expanded', 'true');
                        refreshBadgeUI();
                        renderList();
                    }
                });

                document.addEventListener('click', function (e) {
                    if (!notifDropdown.contains(e.target) && !notifBtn.contains(e.target)) {
                        notifDropdown.classList.remove('show');
                        notifBtn.setAttribute('aria-expanded', 'false');
                    }
                });
            }

            if (tabUnread && tabAll) {
                tabUnread.addEventListener('click', function (e) {
                    e.stopPropagation();
                    currentFilter = 'unread';
                    tabUnread.classList.add('active');
                    tabAll.classList.remove('active');
                    renderList();
                });

                tabAll.addEventListener('click', function (e) {
                    e.stopPropagation();
                    currentFilter = 'all';
                    tabAll.classList.add('active');
                    tabUnread.classList.remove('active');
                    renderList();
                });
            }

            if (markAllReadBtn) {
                markAllReadBtn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    markAllAsRead();
                });
            }

            fetchNotifications();
            setInterval(fetchNotifications, 25000);
        })();
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
