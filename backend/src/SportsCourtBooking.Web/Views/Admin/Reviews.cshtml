@model List<SportsCourtBooking.Application.DTOs.ReviewItemDto>
@{
    ViewData["Title"] = "Xử lý đánh giá vi phạm";
    var search = ViewData["Search"] as string;
    var filter = ViewData["Filter"] as string ?? "all";
    var stats = ViewData["Stats"] as SportsCourtBooking.Application.DTOs.ReviewStatsSummaryDto ?? new();
}

<!-- ─── PAGE HEADING ─── -->
<div class="adm-page-top">
    <div>
        <p class="adm-eyebrow">QUẢN LÝ ĐÁNH GIÁ</p>
        <h1 class="adm-heading-title">Xử lý đánh giá vi phạm</h1>
        <p class="adm-heading-desc">Quản trị viên kiểm duyệt phản hồi từ khách hàng, phát hiện và ẩn các đánh giá vi phạm tiêu chuẩn cộng đồng.</p>
    </div>
</div>

<!-- ─── 4 STAT CARDS ─── -->
<div class="adm-kpi-grid" style="margin-bottom: 20px;">
    <!-- Card 1: Tổng số đánh giá -->
    <div class="adm-kpi-card">
        <div class="adm-kpi-left">
            <div class="adm-kpi-icon adm-kpi-icon--blue">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
            </div>
            <div class="adm-kpi-meta">
                <span class="adm-kpi-label">Tổng đánh giá</span>
                <span class="adm-kpi-val">@stats.TotalReviews</span>
                <span class="adm-kpi-sub">Ghi nhận từ khách hàng</span>
            </div>
        </div>
    </div>

    <!-- Card 2: Đang hiển thị -->
    <div class="adm-kpi-card">
        <div class="adm-kpi-left">
            <div class="adm-kpi-icon adm-kpi-icon--green">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
            </div>
            <div class="adm-kpi-meta">
                <span class="adm-kpi-label">Đang hiển thị</span>
                <span class="adm-kpi-val" style="color: #4ade80;">@stats.VisibleReviews</span>
                <span class="adm-kpi-sub">Công khai trên trang sân</span>
            </div>
        </div>
    </div>

    <!-- Card 3: Cảnh báo vi phạm -->
    <div class="adm-kpi-card">
        <div class="adm-kpi-left">
            <div class="adm-kpi-icon adm-kpi-icon--orange">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                    <line x1="12" y1="9" x2="12" y2="13"></line>
                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
            </div>
            <div class="adm-kpi-meta">
                <span class="adm-kpi-label">Cảnh báo vi phạm</span>
                <span class="adm-kpi-val" style="color: #fb923c;">@stats.ReportedReviews</span>
                <span class="adm-kpi-sub">Cần Admin kiểm tra</span>
            </div>
        </div>
    </div>

    <!-- Card 4: Đã ẩn vi phạm -->
    <div class="adm-kpi-card">
        <div class="adm-kpi-left">
            <div class="adm-kpi-icon" style="background-color: rgba(239, 68, 68, 0.16); color: #ef4444;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                    <line x1="1" y1="1" x2="23" y2="23"></line>
                </svg>
            </div>
            <div class="adm-kpi-meta">
                <span class="adm-kpi-label">Đã ẩn vi phạm</span>
                <span class="adm-kpi-val" style="color: #f87171;">@stats.HiddenReviews</span>
                <span class="adm-kpi-sub">Đã khóa khỏi người dùng</span>
            </div>
        </div>
    </div>
</div>

<!-- ─── BỘ LỌC & TÌM KIẾM ─── -->
<div class="adm-card-box" style="margin-bottom: 20px; padding: 14px 20px;">
    <form method="get" asp-action="Reviews" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
        <div style="display:flex; align-items:center; gap:10px; flex:1; max-width:480px;">
            <input type="search"
                   name="search"
                   value="@search"
                   placeholder="Tìm theo khách hàng, tên sân, nội dung bình luận…"
                   class="adm-search-input"
                   style="padding-left:14px; height:36px;" />
            <button type="submit" class="adm-btn-logout" style="padding: 8px 16px; font-size: 12px;">
                Tìm kiếm
            </button>
            @if (!string.IsNullOrWhiteSpace(search) || filter != "all")
            {
                <a asp-action="Reviews" class="adm-neon-link" style="font-size:12px; margin-left:6px;">Xóa lọc</a>
            }
        </div>

        <!-- Filter tabs -->
        <div class="adm-pills-filter">
            <a asp-action="Reviews" asp-route-search="@search" asp-route-filter="all"
               class="adm-pill @(filter == "all" ? "active" : "")">Tất cả (@stats.TotalReviews)</a>
            <a asp-action="Reviews" asp-route-search="@search" asp-route-filter="reported"
               class="adm-pill @(filter == "reported" ? "active" : "")" style="@(stats.ReportedReviews > 0 ? "color:#fb923c;" : "")">Báo cáo vi phạm (@stats.ReportedReviews)</a>
            <a asp-action="Reviews" asp-route-search="@search" asp-route-filter="hidden"
               class="adm-pill @(filter == "hidden" ? "active" : "")">Đã bị ẩn (@stats.HiddenReviews)</a>
            <a asp-action="Reviews" asp-route-search="@search" asp-route-filter="visible"
               class="adm-pill @(filter == "visible" ? "active" : "")">Đang hiển thị (@stats.VisibleReviews)</a>
        </div>
    </form>
</div>

<!-- ─── BẢNG DANH SÁCH ĐÁNH GIÁ ─── -->
<div class="adm-card-box" style="padding: 20px 22px;">
    <div class="adm-box-header" style="margin-bottom: 14px;">
        <h2 class="adm-box-title">
            <span class="adm-box-title-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                    <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
            </span>
            <span>Danh sách phản hồi & đánh giá sân</span>
        </h2>
    </div>

    <div class="adm-table-wrap">
        <table class="adm-table">
            <thead>
                <tr>
                    <th style="width: 35px;">#</th>
                    <th>KHÁCH HÀNG</th>
                    <th>SÂN THỂ THAO</th>
                    <th style="text-align: center; width: 110px;">ĐÁNH GIÁ</th>
                    <th style="min-width: 280px;">NỘI DUNG PHẢN HỒI</th>
                    <th style="text-align: center; width: 100px;">NGÀY ĐĂNG</th>
                    <th style="text-align: center; width: 130px;">TRẠNG THÁI</th>
                    <th style="text-align: center; width: 170px;">THAO TÁC</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="8" style="text-align:center; padding: 32px; color: var(--d-text-sub);">
                            Không tìm thấy đánh giá nào phù hợp với bộ lọc hiện tại.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var (r, index) in Model.Select((item, i) => (item, i + 1)))
                    {
                        var isRowAlert = r.IsReported && !r.IsHidden;
                        <tr style="@(isRowAlert ? "background-color: rgba(249, 115, 22, 0.06);" : "")">
                            <td style="color: var(--d-text-sub); font-weight: 600;">@index</td>
                            <td>
                                <strong style="color: #fff; font-size: 13px;">@r.UserName</strong>
                                <div style="font-size: 11px; color: var(--d-text-muted);">@r.UserEmail</div>
                            </td>
                            <td>
                                <strong style="color: #e6ede9;">@r.CourtName</strong>
                                <div style="font-size: 11px; color: var(--d-text-sub);">@r.CourtTypeName</div>
                            </td>
                            <td style="text-align: center;">
                                <div style="color: #facc15; font-size: 13px; font-weight: 700; display: inline-flex; align-items: center; gap: 3px;">
                                    <span>@r.Rating</span>
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="#facc15" stroke="#facc15" stroke-width="1.5">
                                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                    </svg>
                                </div>
                            </td>
                            <td>
                                <div style="font-size: 12.5px; line-height: 1.5; color: @(r.IsHidden ? "var(--d-text-muted)" : "#e6ede9"); @(r.IsHidden ? "text-decoration: line-through;" : "")">
                                    @r.Comment
                                </div>
                                @if (r.IsHidden && !string.IsNullOrWhiteSpace(r.HiddenReason))
                                {
                                    <div style="margin-top: 6px; padding: 5px 8px; border-radius: 4px; background: rgba(239, 68, 68, 0.12); border-left: 3px solid #ef4444; font-size: 11px; color: #fca5a5;">
                                        <strong>Lý do ẩn:</strong> @r.HiddenReason
                                        @if (r.HiddenAt.HasValue)
                                        {
                                            <span style="opacity: 0.8; margin-left: 4px;">(@r.HiddenAt.Value.ToString("HH:mm dd/MM/yyyy"))</span>
                                        }
                                    </div>
                                }
                            </td>
                            <td style="text-align: center; color: var(--d-text-sub); font-size: 11px;">
                                @r.CreatedAt.ToString("dd/MM/yyyy")
                            </td>
                            <td style="text-align: center;">
                                @if (r.IsHidden)
                                {
                                    <span style="display:inline-block; padding: 3px 8px; border-radius: 6px; font-size: 10.5px; font-weight: 700; background: rgba(239, 68, 68, 0.16); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3);">
                                        Đã ẩn vi phạm
                                    </span>
                                }
                                else if (r.IsReported)
                                {
                                    <span style="display:inline-block; padding: 3px 8px; border-radius: 6px; font-size: 10.5px; font-weight: 700; background: rgba(249, 115, 22, 0.16); color: #fb923c; border: 1px solid rgba(249, 115, 22, 0.3);">
                                        Bị báo cáo
                                    </span>
                                }
                                else
                                {
                                    <span class="adm-badge-success">
                                        Hiển thị
                                    </span>
                                }
                            </td>
                            <td style="text-align: center;">
                                <div style="display: inline-flex; align-items: center; gap: 6px;">
                                    @if (!r.IsHidden)
                                    {
                                        <!-- Nút Ẩn Đánh Giá -->
                                        <button type="button"
                                                class="adm-btn-logout btn-open-hide-modal"
                                                style="background-color: #ef4444; color: #fff; padding: 4px 10px; font-size: 11px; font-weight: 700;"
                                                data-id="@r.Id"
                                                data-name="@r.UserName"
                                                data-court="@r.CourtName"
                                                data-comment="@r.Comment">
                                            Ẩn vi phạm
                                        </button>
                                    }
                                    else
                                    {
                                        <!-- Nút Bỏ Ẩn (Khôi phục hiển thị) -->
                                        <form asp-action="UnhideReview" method="post" style="display:inline; margin:0;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@r.Id" />
                                            <input type="hidden" name="returnSearch" value="@search" />
                                            <input type="hidden" name="returnFilter" value="@filter" />
                                            <button type="submit"
                                                    class="adm-btn-logout"
                                                    style="background-color: #3b82f6; color: #fff; padding: 4px 10px; font-size: 11px; font-weight: 700;"
                                                    onclick="return confirm('Khôi phục hiển thị lại đánh giá này?')">
                                                Bỏ ẩn
                                            </button>
                                        </form>
                                    }

                                    <!-- Nút Xóa vĩnh viễn -->
                                    <form asp-action="DeleteReview" method="post" style="display:inline; margin:0;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@r.Id" />
                                        <input type="hidden" name="returnSearch" value="@search" />
                                        <input type="hidden" name="returnFilter" value="@filter" />
                                        <button type="submit"
                                                class="adm-icon-btn"
                                                style="color: var(--d-text-sub); padding: 4px;"
                                                title="Xóa đánh giá vĩnh viễn"
                                                onclick="return confirm('Bạn có chắc chắn muốn xóa vĩnh viễn đánh giá này?')">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="3 6 5 6 21 6"></polyline>
                                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                            </svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ─── MODAL ẨN ĐÁNH GIÁ VI PHẠM ─── -->
<div id="hideReviewModal" class="category-modal" role="dialog" aria-modal="true" aria-labelledby="hideModalTitle">
    <div class="category-modal-box" style="background-color: #111d1c; border: 1px solid var(--d-border); border-radius: 12px; color: #fff; max-width: 520px;">
        <div class="category-modal-header" style="border-bottom: 1px solid var(--d-border); padding: 16px 20px;">
            <div style="display: flex; align-items: center; gap: 8px;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
                </svg>
                <h3 id="hideModalTitle" style="margin: 0; font-size: 16px; font-weight: 700; color: #fff;">
                    Ẩn đánh giá vi phạm
                </h3>
            </div>
            <button type="button" class="category-modal-close" onclick="closeHideModal()" style="color: var(--d-text-sub);">&times;</button>
        </div>

        <form asp-action="HideReview" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" id="hideReviewId" name="id" value="" />
            <input type="hidden" name="returnSearch" value="@search" />
            <input type="hidden" name="returnFilter" value="@filter" />

            <div class="category-modal-body" style="padding: 20px;">
                <!-- Review Summary Preview -->
                <div style="background-color: #0c1615; border: 1px solid var(--d-border); border-radius: 8px; padding: 12px 14px; margin-bottom: 16px;">
                    <div style="font-size: 11px; color: var(--d-text-sub); margin-bottom: 4px;">
                        Khách hàng: <strong id="modalUserName" style="color: #fff;"></strong> · Sân: <strong id="modalCourtName" style="color: #fff;"></strong>
                    </div>
                    <div id="modalComment" style="font-size: 12px; color: #e6ede9; font-style: italic;"></div>
                </div>

                <!-- Lý do mẫu nhanh -->
                <div class="form-field" style="margin-bottom: 14px;">
                    <label style="display: block; margin-bottom: 8px; font-size: 12px; font-weight: 700; color: #fff;">
                        Chọn lý do vi phạm mẫu:
                    </label>
                    <div style="display: flex; flex-direction: column; gap: 6px;">
                        <label style="font-size: 12px; color: var(--d-text-sub); display: flex; align-items: center; gap: 8px; cursor: pointer;">
                            <input type="radio" name="quickReason" value="Ngôn từ thô tục, xúc phạm hoặc bôi nhọ người khác" onchange="applyReason(this.value)" />
                            <span>Ngôn từ thô tục, xúc phạm hoặc bôi nhọ người khác</span>
                        </label>
                        <label style="font-size: 12px; color: var(--d-text-sub); display: flex; align-items: center; gap: 8px; cursor: pointer;">
                            <input type="radio" name="quickReason" value="Spam, quảng cáo hoặc tiếp thị dịch vụ trái phép" onchange="applyReason(this.value)" />
                            <span>Spam, quảng cáo hoặc tiếp thị dịch vụ trái phép</span>
                        </label>
                        <label style="font-size: 12px; color: var(--d-text-sub); display: flex; align-items: center; gap: 8px; cursor: pointer;">
                            <input type="radio" name="quickReason" value="Thông tin bịa đặt, sai sự thật gây ảnh hưởng uy tín sân" onchange="applyReason(this.value)" />
                            <span>Thông tin bịa đặt, sai sự thật gây ảnh hưởng uy tín sân</span>
                        </label>
                        <label style="font-size: 12px; color: var(--d-text-sub); display: flex; align-items: center; gap: 8px; cursor: pointer;">
                            <input type="radio" name="quickReason" value="Nội dung không liên quan đến trải nghiệm thực tế tại sân" onchange="applyReason(this.value)" />
                            <span>Nội dung không liên quan đến trải nghiệm thực tế tại sân</span>
                        </label>
                    </div>
                </div>

                <!-- Chi tiết lý do -->
                <div class="form-field" style="margin-bottom: 0;">
                    <label for="hideReasonInput" style="display: block; margin-bottom: 6px; font-size: 12px; font-weight: 700; color: #fff;">
                        Nội dung lý do ẩn vi phạm <span style="color: #ef4444;">*</span>
                    </label>
                    <textarea id="hideReasonInput"
                              name="reason"
                              required
                              maxlength="500"
                              rows="3"
                              placeholder="Nhập chi tiết lý do vi phạm để lưu lịch sử kiểm duyệt…"
                              style="width: 100%; box-sizing: border-box; background-color: var(--d-card-inner); border: 1px solid var(--d-border); border-radius: 6px; color: #fff; padding: 10px 12px; font-family: inherit; font-size: 12px;"></textarea>
                </div>
            </div>

            <div class="category-modal-footer" style="border-top: 1px solid var(--d-border); background-color: #0c1615; padding: 14px 20px; display: flex; justify-content: flex-end; gap: 10px;">
                <button type="button" class="adm-btn-logout" style="background: var(--d-card); color: var(--d-text-sub); border: 1px solid var(--d-border);" onclick="closeHideModal()">
                    Hủy bỏ
                </button>
                <button type="submit" class="adm-btn-logout" style="background-color: #ef4444; color: #fff; font-weight: 700;">
                    Xác nhận ẩn vi phạm
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function openHideModal(id, name, court, comment) {
        document.getElementById('hideReviewId').value = id;
        document.getElementById('modalUserName').innerText = name;
        document.getElementById('modalCourtName').innerText = court;
        document.getElementById('modalComment').innerText = '"' + comment + '"';
        document.getElementById('hideReasonInput').value = '';
        
        // Uncheck quick radio
        const radios = document.getElementsByName('quickReason');
        radios.forEach(r => r.checked = false);

        document.getElementById('hideReviewModal').classList.add('is-active');
    }

    function closeHideModal() {
        document.getElementById('hideReviewModal').classList.remove('is-active');
    }

    function applyReason(val) {
        document.getElementById('hideReasonInput').value = val;
    }

    // Attach event listeners to all edit buttons
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.btn-open-hide-modal').forEach(function (btn) {
            btn.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                const name = this.getAttribute('data-name');
                const court = this.getAttribute('data-court');
                const comment = this.getAttribute('data-comment');
                openHideModal(id, name, court, comment);
            });
        });
    });
</script>
}
