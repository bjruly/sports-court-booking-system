@model List<SportsCourtBooking.Application.DTOs.CourtOwnerItemDto>
@{
    ViewData["Title"] = "Quản lý chủ sân";
    var currentFilter = (string)(ViewData["Filter"] ?? "all");
    var currentSearch = (string)(ViewData["Search"] ?? "");
    var stats = (SportsCourtBooking.Application.DTOs.CourtOwnerStatsDto?)ViewBag.Stats;
}

<div class="adm-page-top">
    <div>
        <p class="adm-eyebrow">QUẢN LÝ NGƯỜI DÙNG</p>
        <h1 class="adm-heading-title">Quản lý Chủ sân (Owner)</h1>
        <p class="adm-heading-desc">Danh sách đối tác chủ sân, kiểm soát quyền truy cập và khóa/mở khóa tài khoản chủ sân.</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="adm-alert adm-alert--success">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
        </svg>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="adm-alert adm-alert--error">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <span>@TempData["ErrorMessage"]</span>
    </div>
}

<!-- ─── 4 KPI CARDS THỐNG KÊ CHỦ SÂN ─── -->
<div class="adm-kpi-grid" style="margin-bottom: 24px;">
    <!-- Tổng chủ sân -->
    <div class="adm-kpi-card">
        <div class="adm-kpi-left">
            <div class="adm-kpi-icon adm-kpi-icon--blue">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
            </div>
            <div class="adm-kpi-meta">
                <span class="adm-kpi-label">Tổng số chủ sân</span>
                <span class="adm-kpi-value">@(stats?.TotalOwners ?? 0)</span>
            </div>
        </div>
        <div class="adm-kpi-sub">Đối tác toàn hệ thống</div>
    </div>

    <!-- Đang hoạt động -->
    <div class="adm-kpi-card">
        <div class="adm-kpi-left">
            <div class="adm-kpi-icon adm-kpi-icon--green">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
            </div>
            <div class="adm-kpi-meta">
                <span class="adm-kpi-label">Đang hoạt động</span>
                <span class="adm-kpi-value" style="color: #4ade80;">@(stats?.ActiveOwners ?? 0)</span>
            </div>
        </div>
        <div class="adm-kpi-sub">Đang vận hành bình thường</div>
    </div>

    <!-- Đang bị khóa -->
    <div class="adm-kpi-card">
        <div class="adm-kpi-left">
            <div class="adm-kpi-icon" style="background: rgba(239, 68, 68, 0.16); color: #f87171;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
            </div>
            <div class="adm-kpi-meta">
                <span class="adm-kpi-label">Đang bị khóa</span>
                <span class="adm-kpi-value" style="color: #f87171;">@(stats?.LockedOwners ?? 0)</span>
            </div>
        </div>
        <div class="adm-kpi-sub">Bị tạm ngừng đăng nhập</div>
    </div>

    <!-- Cơ sở trực thuộc -->
    <div class="adm-kpi-card">
        <div class="adm-kpi-left">
            <div class="adm-kpi-icon" style="background: rgba(168, 85, 247, 0.16); color: #c084fc;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                </svg>
            </div>
            <div class="adm-kpi-meta">
                <span class="adm-kpi-label">Tổng số cơ sở</span>
                <span class="adm-kpi-value" style="color: #c084fc;">@(stats?.TotalFacilities ?? 0)</span>
            </div>
        </div>
        <div class="adm-kpi-sub">Cơ sở thể thao đã đăng ký</div>
    </div>
</div>

<!-- ─── BỘ LỌC & TÌM KIẾM ─── -->
<div class="adm-filter-bar adm-owner-filter-bar">
    <form method="get" asp-action="Owners" class="adm-search-form adm-owner-search-form">
        <input type="hidden" name="filter" value="@currentFilter" />
        <div class="adm-input-wrap adm-owner-input-wrap">
            <input type="text"
                   name="search"
                   value="@currentSearch"
                   class="adm-input adm-owner-search-input"
                   aria-label="Tìm chủ sân"
                   placeholder="Tìm theo tên chủ sân, email, số điện thoại..." />
            @if (!string.IsNullOrWhiteSpace(currentSearch))
            {
                <a asp-action="Owners" asp-route-filter="@currentFilter" class="adm-clear-search" style="position:absolute; right:10px; top:50%; transform:translateY(-50%); color:var(--adm-text-sub); text-decoration:none;">✕</a>
            }
        </div>
        <button type="submit" class="adm-btn-create adm-owner-search-button">
            Tìm kiếm
        </button>
    </form>

    <div class="adm-filter-tabs adm-owner-filter-tabs">
        <a asp-action="Owners" asp-route-filter="all" asp-route-search="@currentSearch"
           class="adm-tab @(currentFilter == "all" ? "active" : "")">
            Tất cả (@(stats?.TotalOwners ?? 0))
        </a>
        <a asp-action="Owners" asp-route-filter="active" asp-route-search="@currentSearch"
           class="adm-tab @(currentFilter == "active" ? "active" : "")">
            Đang hoạt động (@(stats?.ActiveOwners ?? 0))
        </a>
        <a asp-action="Owners" asp-route-filter="locked" asp-route-search="@currentSearch"
           class="adm-tab @(currentFilter == "locked" ? "active" : "")">
            Đang bị khóa (@(stats?.LockedOwners ?? 0))
        </a>
    </div>
</div>

<!-- ─── BẢNG DANH SÁCH CHỦ SÂN ─── -->
<div class="adm-table-wrap">
    <div style="overflow-x: auto;">
        <table class="adm-table">
            <thead>
                <tr>
                    <th style="width: 50px;">#</th>
                    <th>Chủ sân</th>
                    <th>Thông tin liên hệ</th>
                    <th style="text-align: center;">Cơ sở & Sân</th>
                    <th style="text-align: center;">Ngày đăng ký</th>
                    <th style="text-align: center;">Trạng thái</th>
                    <th style="text-align: center; width: 160px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="7" style="text-align:center; padding: 48px 16px; color: var(--adm-text-sub);">
                            <div style="display:flex; flex-direction:column; align-items:center; gap:8px;">
                                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="opacity:0.4;">
                                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="9" cy="7" r="4"></circle>
                                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                </svg>
                                <span>Chưa tìm thấy chủ sân nào phù hợp với bộ lọc.</span>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    int idx = 1;
                    @foreach (var owner in Model)
                    {
                        <tr>
                            <td style="color: var(--adm-text-sub); font-size: 13px;">@idx</td>
                            <td>
                                <strong style="font-size: 14px; color: #fff; display: block;">@owner.FullName</strong>
                                <span style="font-size: 12px; color: var(--adm-text-sub);">ID: #@owner.Id</span>
                            </td>
                            <td>
                                <div style="font-size: 13px; color: var(--adm-text);">@owner.Email</div>
                                <div style="font-size: 12px; color: var(--adm-text-sub); margin-top: 2px;">
                                    📞 @(string.IsNullOrWhiteSpace(owner.PhoneNumber) ? "Chưa cập nhật" : owner.PhoneNumber)
                                </div>
                            </td>
                            <td style="text-align: center;">
                                <div style="font-weight: 700; color: #38bdf8; font-size: 14px;">
                                    @owner.FacilityCount <span style="font-size: 12px; font-weight: normal; color: var(--adm-text-sub);">cơ sở</span>
                                </div>
                                <div style="font-size: 12px; color: var(--adm-text-sub); margin-top: 2px;">
                                    @owner.CourtCount sân trực thuộc
                                </div>
                            </td>
                            <td style="text-align: center; font-size: 12.5px; color: var(--adm-text-sub);">
                                @owner.CreatedAt.ToString("dd/MM/yyyy")
                            </td>
                            <td style="text-align: center;">
                                @if (owner.IsActive)
                                {
                                    <span style="display:inline-block; padding: 4px 10px; border-radius: 6px; font-size: 11.5px; font-weight: 700; background: rgba(34, 197, 94, 0.16); color: #4ade80; border: 1px solid rgba(34, 197, 94, 0.3);">
                                        🟢 Hoạt động
                                    </span>
                                }
                                else
                                {
                                    <span style="display:inline-block; padding: 4px 10px; border-radius: 6px; font-size: 11.5px; font-weight: 700; background: rgba(239, 68, 68, 0.16); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3);">
                                        🔒 Đang bị khóa
                                    </span>
                                }
                            </td>
                            <td style="text-align: center;">
                                @if (owner.IsActive)
                                {
                                    <!-- Nút Khóa tài khoản -->
                                    <form asp-action="ToggleLockOwner" method="post" style="display:inline; margin:0;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@owner.Id" />
                                        <input type="hidden" name="returnSearch" value="@currentSearch" />
                                        <input type="hidden" name="returnFilter" value="@currentFilter" />
                                        <button type="submit"
                                                class="adm-action-btn"
                                                style="color: #f87171; border-color: rgba(239, 68, 68, 0.35); background: rgba(239, 68, 68, 0.1); padding: 5px 12px; font-size: 12px; height: 32px; display: inline-flex; align-items: center; gap: 6px; font-weight: 600; cursor: pointer; border-radius: 6px;"
                                                onclick="return confirm('Bạn có chắc muốn KHÓA tài khoản của chủ sân @owner.FullName? Khi bị khóa, chủ sân sẽ không thể đăng nhập vào trang quản trị.');"
                                                title="Khóa tài khoản chủ sân">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                            </svg>
                                            <span>Khóa tài khoản</span>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <!-- Nút Mở khóa tài khoản -->
                                    <form asp-action="ToggleLockOwner" method="post" style="display:inline; margin:0;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@owner.Id" />
                                        <input type="hidden" name="returnSearch" value="@currentSearch" />
                                        <input type="hidden" name="returnFilter" value="@currentFilter" />
                                        <button type="submit"
                                                class="adm-btn-create"
                                                style="padding: 5px 12px; font-size: 12px; background: #22c55e; color: #071f15; height: 32px; font-weight: 700; display: inline-flex; align-items: center; gap: 6px; cursor: pointer; border-radius: 6px;"
                                                onclick="return confirm('Bạn có chắc muốn MỞ KHÓA tài khoản cho chủ sân @owner.FullName? Chủ sân sẽ có thể đăng nhập lại bình thường.');"
                                                title="Mở khóa tài khoản chủ sân">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                                <path d="M7 11V7a5 5 0 0 1 9.9-1"></path>
                                            </svg>
                                            <span>Mở khóa</span>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                        idx++;
                    }
                }
            </tbody>
        </table>
    </div>
</div>
