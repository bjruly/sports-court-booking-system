@model List<SportsCourtBooking.Application.DTOs.FacilityItemDto>
@{
    ViewData["Title"] = "Quản lý cơ sở thể thao";
    var currentFilter = (string)(ViewData["Filter"] ?? "all");
    var currentSearch = (string)(ViewData["Search"] ?? "");
    var stats = (SportsCourtBooking.Application.DTOs.FacilityStatsDto?)ViewBag.Stats;
}

<div class="adm-page-top">
    <div>
        <p class="adm-eyebrow">QUẢN LÝ HỆ THỐNG</p>
        <h1 class="adm-heading-title">Cơ sở thể thao</h1>
        <p class="adm-heading-desc">Quản lý danh sách các cụm sân, phê duyệt cơ sở mới đăng ký và kiểm soát trạng thái hoạt động.</p>
    </div>

    <div class="adm-top-actions">
        <button type="button" class="adm-btn-create" onclick="openCreateFacilityModal()" style="display:inline-flex; align-items:center; gap:8px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>Thêm cơ sở mới</span>
        </button>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="adm-alert adm-alert--success">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
        </svg>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="adm-alert adm-alert--error">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <span>@TempData["ErrorMessage"]</span>
    </div>
}

<!-- ─── 4 KPI CARDS THỐNG KÊ CƠ SỞ ─── -->
<div class="adm-kpi-grid" style="margin-bottom: 24px;">
    <!-- Tổng cơ sở -->
    <div class="adm-kpi-card">
        <div class="adm-kpi-left">
            <div class="adm-kpi-icon adm-kpi-icon--blue">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                </svg>
            </div>
            <div class="adm-kpi-meta">
                <span class="adm-kpi-label">Tổng số cơ sở</span>
                <span class="adm-kpi-value">@(stats?.TotalFacilities ?? 0)</span>
            </div>
        </div>
        <div class="adm-kpi-sub">Hệ thống toàn quốc</div>
    </div>

    <!-- Đang hoạt động -->
    <div class="adm-kpi-card">
        <div class="adm-kpi-left">
            <div class="adm-kpi-icon adm-kpi-icon--green">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 14 14"></polyline>
                </svg>
            </div>
            <div class="adm-kpi-meta">
                <span class="adm-kpi-label">Đang hoạt động</span>
                <span class="adm-kpi-value" style="color: #4ade80;">@(stats?.ActiveFacilities ?? 0)</span>
            </div>
        </div>
        <div class="adm-kpi-sub">Sẵn sàng nhận khách</div>
    </div>

    <!-- Chờ phê duyệt -->
    <div class="adm-kpi-card">
        <div class="adm-kpi-left">
            <div class="adm-kpi-icon" style="background: rgba(234, 179, 8, 0.16); color: #facc15;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
            </div>
            <div class="adm-kpi-meta">
                <span class="adm-kpi-label">Chờ phê duyệt</span>
                <span class="adm-kpi-value" style="color: #facc15;">@(stats?.PendingApprovalFacilities ?? 0)</span>
            </div>
        </div>
        <div class="adm-kpi-sub">Cơ sở mới đăng ký</div>
    </div>

    <!-- Tạm khóa -->
    <div class="adm-kpi-card">
        <div class="adm-kpi-left">
            <div class="adm-kpi-icon" style="background: rgba(239, 68, 68, 0.16); color: #f87171;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
            </div>
            <div class="adm-kpi-meta">
                <span class="adm-kpi-label">Đang tạm khóa</span>
                <span class="adm-kpi-value" style="color: #f87171;">@(stats?.SuspendedFacilities ?? 0)</span>
            </div>
        </div>
        <div class="adm-kpi-sub">Dừng hoạt động</div>
    </div>
</div>

<!-- ─── BỘ LỌC VÀ TÌM KIẾM ─── -->
<div class="adm-card" style="padding: 16px 20px; margin-bottom: 20px;">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px;">
        <!-- Tabs lọc nhanh -->
        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
            <a href="@Url.Action("Facilities", new { search = currentSearch, filter = "all" })"
               class="adm-tab-pill @(currentFilter == "all" ? "active" : "")">
                Tất cả (@(stats?.TotalFacilities ?? 0))
            </a>
            <a href="@Url.Action("Facilities", new { search = currentSearch, filter = "active" })"
               class="adm-tab-pill @(currentFilter == "active" ? "active" : "")">
                Đang hoạt động (@(stats?.ActiveFacilities ?? 0))
            </a>
            <a href="@Url.Action("Facilities", new { search = currentSearch, filter = "pending" })"
               class="adm-tab-pill @(currentFilter == "pending" ? "active" : "")"
               style="@(stats?.PendingApprovalFacilities > 0 ? "border-color: rgba(234, 179, 8, 0.4); color: #facc15;" : "")">
                Chờ duyệt (@(stats?.PendingApprovalFacilities ?? 0))
            </a>
            <a href="@Url.Action("Facilities", new { search = currentSearch, filter = "suspended" })"
               class="adm-tab-pill @(currentFilter == "suspended" ? "active" : "")"
               style="@(stats?.SuspendedFacilities > 0 ? "border-color: rgba(239, 68, 68, 0.4); color: #f87171;" : "")">
                Tạm khóa (@(stats?.SuspendedFacilities ?? 0))
            </a>
        </div>

        <!-- Form tìm kiếm -->
        <form method="get" asp-action="Facilities" style="display: flex; gap: 8px; margin: 0; min-width: 320px;">
            <input type="hidden" name="filter" value="@currentFilter" />
            <div style="position: relative; flex: 1;">
                <input type="text"
                       name="search"
                       value="@currentSearch"
                       placeholder="Tìm kiếm cơ sở, địa chỉ, SĐT..."
                       class="adm-form-input"
                       style="padding-left: 36px; height: 38px;" />
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--d-text-sub)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"
                     style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%);">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
            </div>
            <button type="submit" class="adm-btn-create" style="height: 38px; padding: 0 16px;">
                Tìm
            </button>
            @if (!string.IsNullOrWhiteSpace(currentSearch))
            {
                <a href="@Url.Action("Facilities", new { filter = currentFilter })" class="adm-tab-pill" style="height: 38px; display: inline-flex; align-items: center;">
                    Đặt lại
                </a>
            }
        </form>
    </div>
</div>

<!-- ─── BẢNG DANH SÁCH CƠ SỞ THỂ THAO ─── -->
<div class="adm-card">
    <div class="adm-card-header">
        <div>
            <h2 class="adm-card-title">Danh sách cơ sở thể thao</h2>
            <p class="adm-card-sub">Tổng cộng @Model.Count cơ sở phù hợp điều kiện lọc</p>
        </div>
    </div>

    <div class="adm-table-wrap">
        <table class="adm-table">
            <thead>
                <tr>
                    <th style="width: 50px; text-align: center;">#</th>
                    <th style="width: 280px;">TÊN CƠ SỞ</th>
                    <th>ĐỊA CHỈ & LIÊN HỆ</th>
                    <th style="width: 140px; text-align: center;">GIỜ HOẠT ĐỘNG</th>
                    <th style="width: 100px; text-align: center;">QUY MÔ</th>
                    <th style="width: 150px; text-align: center;">TRẠNG THÁI</th>
                    <th style="width: 180px; text-align: center;">THAO TÁC</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="7" style="text-align: center; padding: 48px; color: var(--d-text-sub);">
                            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 10px; opacity: 0.5;">
                                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                <polyline points="9 22 9 12 15 12 15 22"></polyline>
                            </svg>
                            <p style="margin: 0; font-size: 14px;">Không tìm thấy cơ sở thể thao nào.</p>
                        </td>
                    </tr>
                }
                else
                {
                    var idx = 1;
                    foreach (var f in Model)
                    {
                        <tr>
                            <td style="text-align: center; color: var(--d-text-sub); font-weight: 600;">@idx</td>
                            <td>
                                <div style="font-weight: 700; color: #fff; font-size: 13.5px; margin-bottom: 3px;">
                                    @f.Name
                                </div>
                                @if (!string.IsNullOrWhiteSpace(f.Description))
                                {
                                    <div style="font-size: 11.5px; color: var(--d-text-sub); line-height: 1.4; max-width: 260px;">
                                        @f.Description
                                    </div>
                                }
                            </td>
                            <td>
                                <div style="font-size: 12.5px; color: #e6ede9; margin-bottom: 4px; display: flex; align-items: center; gap: 6px;">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--d-green)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                        <circle cx="12" cy="10" r="3"></circle>
                                    </svg>
                                    <span>@f.Address</span>
                                </div>
                                <div style="font-size: 11.5px; color: var(--d-text-sub); display: flex; align-items: center; gap: 6px;">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                                    </svg>
                                    <span>Hotline: @f.PhoneNumber</span>
                                </div>
                            </td>
                            <td style="text-align: center;">
                                <div style="font-size: 12px; font-weight: 600; color: #fff; background: rgba(255,255,255,0.06); padding: 4px 8px; border-radius: 6px; display: inline-block;">
                                    @f.OpenTime - @f.CloseTime
                                </div>
                            </td>
                            <td style="text-align: center;">
                                <div style="font-weight: 700; color: #38bdf8; font-size: 13px;">
                                    @f.TotalCourts sân
                                </div>
                            </td>
                            <td style="text-align: center;">
                                @if (!f.IsApproved)
                                {
                                    <span style="display:inline-block; padding: 4px 10px; border-radius: 6px; font-size: 11px; font-weight: 700; background: rgba(234, 179, 8, 0.16); color: #facc15; border: 1px solid rgba(234, 179, 8, 0.3);">
                                        Chờ phê duyệt
                                    </span>
                                }
                                else if (!f.IsActive)
                                {
                                    <span style="display:inline-block; padding: 4px 10px; border-radius: 6px; font-size: 11px; font-weight: 700; background: rgba(239, 68, 68, 0.16); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3);"
                                          title="@f.SuspensionReason">
                                        Tạm khóa
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(f.SuspensionReason))
                                    {
                                        <div style="font-size: 10px; color: #fca5a5; margin-top: 4px; max-width: 140px; margin-left: auto; margin-right: auto; line-height: 1.2;">
                                            @f.SuspensionReason
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span style="display:inline-block; padding: 4px 10px; border-radius: 6px; font-size: 11px; font-weight: 700; background: rgba(34, 197, 94, 0.16); color: #4ade80; border: 1px solid rgba(34, 197, 94, 0.3);">
                                        Hoạt động
                                    </span>
                                }
                            </td>
                            <td style="text-align: center;">
                                <div style="display: inline-flex; align-items: center; gap: 6px;">
                                    <!-- Nút Duyệt nếu chưa duyệt -->
                                    @if (!f.IsApproved)
                                    {
                                        <form asp-action="ApproveFacility" method="post" style="display:inline; margin:0;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@f.Id" />
                                            <input type="hidden" name="returnSearch" value="@currentSearch" />
                                            <input type="hidden" name="returnFilter" value="@currentFilter" />
                                            <button type="submit" class="adm-btn-create" style="padding: 5px 10px; font-size: 11px; background: #22c55e; color: #071f15;"
                                                    onclick="return confirm('Xác nhận phê duyệt cơ sở &quot;@f.Name&quot; hoạt động chính thức?');"
                                                    title="Phê duyệt cơ sở">
                                                Duyệt
                                            </button>
                                        </form>
                                    }

                                    <!-- Nút Khóa / Mở khóa -->
                                    @if (f.IsActive)
                                    {
                                        <button type="button"
                                                class="adm-action-btn"
                                                style="color: #f87171; border-color: rgba(239, 68, 68, 0.35); background: rgba(239, 68, 68, 0.1);"
                                                onclick="openLockFacilityModal(@f.Id, '@f.Name')"
                                                title="Khóa cơ sở">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                            </svg>
                                        </button>
                                    }
                                    else
                                    {
                                        <form asp-action="ToggleLockFacility" method="post" style="display:inline; margin:0;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@f.Id" />
                                            <input type="hidden" name="returnSearch" value="@currentSearch" />
                                            <input type="hidden" name="returnFilter" value="@currentFilter" />
                                            <button type="submit"
                                                    class="adm-action-btn"
                                                    style="color: #4ade80; border-color: rgba(34, 197, 94, 0.35); background: rgba(34, 197, 94, 0.1);"
                                                    onclick="return confirm('Mở khóa cho cơ sở &quot;@f.Name&quot; hoạt động trở lại?');"
                                                    title="Mở khóa cơ sở">
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                                    <path d="M7 11V7a5 5 0 0 1 9.9-1"></path>
                                                </svg>
                                            </button>
                                        </form>
                                    }

                                    <!-- Nút Sửa -->
                                    <button type="button"
                                            class="adm-action-btn"
                                            onclick="openEditFacilityModal(@f.Id, '@Html.Raw(f.Name)', '@Html.Raw(f.Address)', '@f.PhoneNumber', '@f.OpenTime', '@f.CloseTime', '@Html.Raw(f.Description ?? "")')"
                                            title="Chỉnh sửa thông tin">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M12 20h9"></path>
                                            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        idx++;
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ─── MODAL 1: THÊM CƠ SỞ MỚI ─── -->
<div id="createFacilityModal" class="adm-modal-backdrop" style="display:none;">
    <div class="adm-modal" style="max-width: 520px;">
        <div class="adm-modal-header">
            <h3 class="adm-modal-title">Thêm cơ sở thể thao mới</h3>
            <button type="button" class="adm-modal-close" onclick="closeCreateFacilityModal()">&times;</button>
        </div>
        <form asp-action="CreateFacility" method="post">
            @Html.AntiForgeryToken()
            <div class="adm-modal-body">
                <div class="adm-form-group">
                    <label class="adm-form-label">Tên cơ sở thể thao <span style="color:#ef4444;">*</span></label>
                    <input type="text" name="Name" class="adm-form-input" placeholder="VD: CLB Thể Thao SGU - Quận 5" required />
                </div>
                <div class="adm-form-group">
                    <label class="adm-form-label">Địa chỉ cơ sở <span style="color:#ef4444;">*</span></label>
                    <input type="text" name="Address" class="adm-form-input" placeholder="VD: 105 An Dương Vương, P.4, Q.5, TP.HCM" required />
                </div>
                <div class="adm-form-group">
                    <label class="adm-form-label">Số điện thoại liên hệ <span style="color:#ef4444;">*</span></label>
                    <input type="text" name="PhoneNumber" class="adm-form-input" placeholder="VD: 028 3835 4409 hoặc 090xxxxxxx" required />
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                    <div class="adm-form-group">
                        <label class="adm-form-label">Giờ mở cửa</label>
                        <input type="text" name="OpenTime" class="adm-form-input" value="06:00" placeholder="06:00" />
                    </div>
                    <div class="adm-form-group">
                        <label class="adm-form-label">Giờ đóng cửa</label>
                        <input type="text" name="CloseTime" class="adm-form-input" value="22:00" placeholder="22:00" />
                    </div>
                </div>
                <div class="adm-form-group" style="margin-bottom:0;">
                    <label class="adm-form-label">Mô tả giới thiệu cơ sở</label>
                    <textarea name="Description" class="adm-form-textarea" rows="3" placeholder="Giới thiệu về cơ sở, tiện ích, bãi xe, thảm sân..."></textarea>
                </div>
            </div>
            <div class="adm-modal-footer">
                <button type="button" class="adm-btn-cancel" onclick="closeCreateFacilityModal()">Hủy</button>
                <button type="submit" class="adm-btn-create">Lưu cơ sở</button>
            </div>
        </form>
    </div>
</div>

<!-- ─── MODAL 2: CHỈNH SỬA CƠ SỞ ─── -->
<div id="editFacilityModal" class="adm-modal-backdrop" style="display:none;">
    <div class="adm-modal" style="max-width: 520px;">
        <div class="adm-modal-header">
            <h3 class="adm-modal-title">Chỉnh sửa thông tin cơ sở</h3>
            <button type="button" class="adm-modal-close" onclick="closeEditFacilityModal()">&times;</button>
        </div>
        <form asp-action="UpdateFacility" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" id="editFacilityId" />
            <div class="adm-modal-body">
                <div class="adm-form-group">
                    <label class="adm-form-label">Tên cơ sở <span style="color:#ef4444;">*</span></label>
                    <input type="text" name="Name" id="editFacilityName" class="adm-form-input" required />
                </div>
                <div class="adm-form-group">
                    <label class="adm-form-label">Địa chỉ <span style="color:#ef4444;">*</span></label>
                    <input type="text" name="Address" id="editFacilityAddress" class="adm-form-input" required />
                </div>
                <div class="adm-form-group">
                    <label class="adm-form-label">Số điện thoại <span style="color:#ef4444;">*</span></label>
                    <input type="text" name="PhoneNumber" id="editFacilityPhone" class="adm-form-input" required />
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                    <div class="adm-form-group">
                        <label class="adm-form-label">Giờ mở cửa</label>
                        <input type="text" name="OpenTime" id="editFacilityOpen" class="adm-form-input" />
                    </div>
                    <div class="adm-form-group">
                        <label class="adm-form-label">Giờ đóng cửa</label>
                        <input type="text" name="CloseTime" id="editFacilityClose" class="adm-form-input" />
                    </div>
                </div>
                <div class="adm-form-group" style="margin-bottom:0;">
                    <label class="adm-form-label">Mô tả</label>
                    <textarea name="Description" id="editFacilityDesc" class="adm-form-textarea" rows="3"></textarea>
                </div>
            </div>
            <div class="adm-modal-footer">
                <button type="button" class="adm-btn-cancel" onclick="closeEditFacilityModal()">Hủy</button>
                <button type="submit" class="adm-btn-create">Cập nhật</button>
            </div>
        </form>
    </div>
</div>

<!-- ─── MODAL 3: TẠM KHÓA CƠ SỞ ─── -->
<div id="lockFacilityModal" class="adm-modal-backdrop" style="display:none;">
    <div class="adm-modal" style="max-width: 480px;">
        <div class="adm-modal-header">
            <h3 class="adm-modal-title" style="color: #f87171;">Tạm khóa cơ sở thể thao</h3>
            <button type="button" class="adm-modal-close" onclick="closeLockFacilityModal()">&times;</button>
        </div>
        <form asp-action="ToggleLockFacility" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="lockFacilityId" />
            <input type="hidden" name="returnSearch" value="@currentSearch" />
            <input type="hidden" name="returnFilter" value="@currentFilter" />
            <div class="adm-modal-body">
                <p style="font-size: 13px; color: var(--d-text-sub); margin-top: 0;">
                    Bạn đang thực hiện tạm khóa cơ sở: <strong id="lockFacilityName" style="color: #fff;"></strong>. Khi bị khóa, khách hàng sẽ không thể tìm thấy và đặt sân tại cơ sở này.
                </p>
                <div class="adm-form-group" style="margin-bottom: 0;">
                    <label class="adm-form-label">Lý do tạm khóa <span style="color:#ef4444;">*</span></label>
                    <select id="lockFacilityQuickSelect" class="adm-form-input" style="margin-bottom: 8px;" onchange="applyQuickLockReason(this.value)">
                        <option value="">-- Chọn nhanh lý do mẫu --</option>
                        <option value="Cơ sở vi phạm quy định tiêu chuẩn an toàn PCCC">Vi phạm tiêu chuẩn an toàn PCCC</option>
                        <option value="Nhận nhiều phản ánh tiêu cực và khiếu nại chưa được xử lý">Nhiều khiếu nại chất lượng chưa xử lý</option>
                        <option value="Chưa hoàn tất nghĩa vụ tài chính và đối soát hệ thống">Chưa hoàn tất nghĩa vụ tài chính</option>
                        <option value="Cơ sở tạm ngưng hoạt động để bảo dưỡng, nâng cấp tổng thể">Tạm ngưng bảo dưỡng, nâng cấp tổng thể</option>
                    </select>
                    <textarea name="reason" id="lockFacilityReason" class="adm-form-textarea" rows="3" placeholder="Nhập chi tiết lý do tạm khóa..." required></textarea>
                </div>
            </div>
            <div class="adm-modal-footer">
                <button type="button" class="adm-btn-cancel" onclick="closeLockFacilityModal()">Hủy</button>
                <button type="submit" class="adm-btn-create" style="background: #ef4444; color: #fff;">Xác nhận khóa</button>
            </div>
        </form>
    </div>
</div>

<script>
    function openCreateFacilityModal() {
        document.getElementById('createFacilityModal').style.display = 'flex';
    }
    function closeCreateFacilityModal() {
        document.getElementById('createFacilityModal').style.display = 'none';
    }

    function openEditFacilityModal(id, name, address, phone, openTime, closeTime, desc) {
        document.getElementById('editFacilityId').value = id;
        document.getElementById('editFacilityName').value = name;
        document.getElementById('editFacilityAddress').value = address;
        document.getElementById('editFacilityPhone').value = phone;
        document.getElementById('editFacilityOpen').value = openTime;
        document.getElementById('editFacilityClose').value = closeTime;
        document.getElementById('editFacilityDesc').value = desc;
        document.getElementById('editFacilityModal').style.display = 'flex';
    }
    function closeEditFacilityModal() {
        document.getElementById('editFacilityModal').style.display = 'none';
    }

    function openLockFacilityModal(id, name) {
        document.getElementById('lockFacilityId').value = id;
        document.getElementById('lockFacilityName').innerText = name;
        document.getElementById('lockFacilityQuickSelect').value = '';
        document.getElementById('lockFacilityReason').value = '';
        document.getElementById('lockFacilityModal').style.display = 'flex';
    }
    function closeLockFacilityModal() {
        document.getElementById('lockFacilityModal').style.display = 'none';
    }
    function applyQuickLockReason(val) {
        if (val) {
            document.getElementById('lockFacilityReason').value = val;
        }
    }

    window.onclick = function(event) {
        ['createFacilityModal', 'editFacilityModal', 'lockFacilityModal'].forEach(id => {
            const el = document.getElementById(id);
            if (event.target === el) {
                el.style.display = 'none';
            }
        });
    };
</script>
