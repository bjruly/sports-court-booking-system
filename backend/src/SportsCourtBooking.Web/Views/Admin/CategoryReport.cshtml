@model List<SportsCourtBooking.Application.DTOs.CategoryDetailReportDto>
@{
    ViewData["Title"] = "Báo cáo chi tiết theo danh mục loại sân";
}

<div class="adm-page-top">
    <div>
        <p class="adm-eyebrow">BÁO CÁO & THỐNG KÊ</p>
        <h1 class="adm-heading-title">Báo cáo phân tích danh mục</h1>
        <p class="adm-heading-desc">Thống kê hiệu quả hoạt động, tỷ lệ lấp đầy và doanh thu chi tiết theo từng loại sân thể thao.</p>
    </div>
    <div class="adm-top-actions">
        <a asp-action="Reports" class="adm-neon-link" style="font-size:13px; font-weight:700;">
            ← Xem báo cáo tổng hợp
        </a>
    </div>
</div>

<div class="adm-mid-grid" style="grid-template-columns: 1fr; margin-bottom: 24px;">
    <div class="adm-card-box">
        <div class="adm-box-header">
            <h2 class="adm-box-title">
                <span class="adm-box-title-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="20" x2="18" y2="10"></line>
                        <line x1="12" y1="20" x2="12" y2="4"></line>
                        <line x1="6" y1="20" x2="6" y2="14"></line>
                    </svg>
                </span>
                <span>Bảng tổng hợp chi tiết theo từng môn / loại sân</span>
            </h2>
        </div>

        <div class="adm-table-wrap">
            <table class="adm-table">
                <thead>
                    <tr>
                        <th style="width: 40px;">#</th>
                        <th>MÔN / LOẠI SÂN</th>
                        <th style="text-align: center;">TỔNG SỐ SÂN</th>
                        <th style="text-align: center;">ĐANG HOẠT ĐỘNG</th>
                        <th style="text-align: center;">TỔNG LƯỢT ĐẶT</th>
                        <th style="text-align: center;">THÀNH CÔNG</th>
                        <th style="text-align: center;">TỶ LỆ THÀNH CÔNG</th>
                        <th style="text-align: right;">DOANH THU THỰC TẾ</th>
                        <th style="text-align: center;">TỶ TRỌNG</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="9" style="text-align:center; padding: 24px; color: var(--d-text-sub);">
                                Chưa có dữ liệu thống kê loại sân nào.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var (cat, index) in Model.Select((c, i) => (c, i + 1)))
                        {
                            <tr>
                                <td style="color: var(--d-text-sub); font-weight: 600;">@index</td>
                                <td>
                                    <strong style="color: #fff; font-size: 13px;">@cat.CourtTypeName</strong>
                                    @if (!string.IsNullOrWhiteSpace(cat.Description))
                                    {
                                        <div style="font-size: 11px; color: var(--d-text-muted); margin-top: 2px;">@cat.Description</div>
                                    }
                                </td>
                                <td style="text-align: center; font-weight: 600;">@cat.TotalCourts sân</td>
                                <td style="text-align: center;">
                                    <span class="adm-badge-success">@cat.ActiveCourts / @cat.TotalCourts</span>
                                </td>
                                <td style="text-align: center; font-weight: 600;">@cat.TotalBookings</td>
                                <td style="text-align: center; font-weight: 600; color: #4ade80;">@cat.SuccessfulBookings</td>
                                <td style="text-align: center; font-weight: 600;">@cat.SuccessRate%</td>
                                <td style="text-align: right; font-weight: 700; color: #fff;">@cat.Revenue.ToString("N0") đ</td>
                                <td style="text-align: center; font-weight: 700; color: #4ade80;">@cat.ContributionPercent%</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
