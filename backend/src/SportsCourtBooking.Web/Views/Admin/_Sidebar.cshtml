<aside class="admin-sidebar" aria-label="Menu quản trị">
    <div class="admin-sidebar-heading">
        <span class="admin-sidebar-brand">SÂN NHÀ <span>ADMIN</span></span>
        <p>Xin chào, @User.Identity?.Name</p>
    </div>

    <nav class="admin-sidebar-menu">
        <details class="admin-menu-group" open>
            <summary>Tổng quan</summary>
            <div class="admin-submenu">
                <a class="admin-menu-item" asp-controller="Admin" asp-action="Index">Thống kê toàn hệ thống</a>
            </div>
        </details>

        <details class="admin-menu-group" open>
            <summary>Quản lý người dùng</summary>
            <div class="admin-submenu">
                <a class="admin-menu-item" asp-controller="Admin" asp-action="Customers">Khách hàng</a>
            </div>
        </details>

        <details class="admin-menu-group">
            <summary>Quản lý danh mục</summary>
            <div class="admin-submenu">
                <span class="admin-menu-item admin-menu-item--disabled" aria-disabled="true"><span>Môn thể thao</span><small>Chưa triển khai</small></span>
                <span class="admin-menu-item admin-menu-item--disabled" aria-disabled="true"><span>Loại sân</span><small>Chưa triển khai</small></span>
            </div>
        </details>

        <details class="admin-menu-group">
            <summary>Quản lý đánh giá</summary>
            <div class="admin-submenu">
                <span class="admin-menu-item admin-menu-item--disabled" aria-disabled="true"><span>Đánh giá vi phạm</span><small>Chưa triển khai</small></span>
                <span class="admin-menu-item admin-menu-item--disabled" aria-disabled="true"><span>Xử lý đánh giá</span><small>Chưa triển khai</small></span>
            </div>
        </details>

        <details class="admin-menu-group" open>
            <summary>Báo cáo thống kê</summary>
            <div class="admin-submenu">
                <a class="admin-menu-item" asp-controller="Admin" asp-action="Reports">Báo cáo tổng hợp</a>
            </div>
        </details>

        <details class="admin-menu-group">
            <summary>Quản lý hệ thống</summary>
            <div class="admin-submenu">
                <span class="admin-menu-item admin-menu-item--disabled" aria-disabled="true"><span>Thông báo</span><small>Chưa triển khai</small></span>
                <span class="admin-menu-item admin-menu-item--disabled" aria-disabled="true"><span>Cấu hình</span><small>Chưa triển khai</small></span>
                <span class="admin-menu-item admin-menu-item--disabled" aria-disabled="true"><span>Hồ sơ Admin</span><small>Chưa triển khai</small></span>
            </div>
        </details>
    </nav>
</aside>
