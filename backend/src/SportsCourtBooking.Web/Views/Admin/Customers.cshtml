@model List<SportsCourtBooking.Application.DTOs.UserDto>
@{
    ViewData["Title"] = "Quản lý khách hàng";
    var search = ViewData["Search"] as string;
}

<section class="admin-page">
    <div class="shell admin-layout">
        @await Html.PartialAsync("_Sidebar")

        <div class="admin-content">
            <header class="admin-page-heading">
                <div>
                    <p class="eyebrow eyebrow--dark"><span class="eyebrow-line"></span> QUẢN LÝ NGƯỜI DÙNG</p>
                    <h1>Khách hàng</h1>
                    <p class="page-subtitle">Danh sách tài khoản khách hàng và trạng thái hoạt động.</p>
                </div>
            </header>

            @* Thanh tìm kiếm *@
            <section class="admin-status-card admin-status-card--block" style="margin-bottom:1.5rem;">
                <form method="get" asp-action="Customers" class="booking-filter-bar">
                    <div class="filter-group">
                        <label for="search" class="sr-only">Tìm kiếm</label>
                        <input id="search"
                               type="search"
                               name="search"
                               value="@search"
                               placeholder="Tìm theo tên, email, số điện thoại…"
                               class="filter-input" />
                    </div>
                    <button type="submit" class="button button--small button--dark">Tìm kiếm</button>
                    @if (!string.IsNullOrWhiteSpace(search))
                    {
                        <a asp-action="Customers" class="text-link">Xóa bộ lọc</a>
                    }
                </form>
            </section>

            @* Bảng danh sách *@
            <section class="admin-status-card admin-status-card--block">
                @if (!Model.Any())
                {
                    <p style="color:var(--color-muted);padding:1rem 0;">
                        @(string.IsNullOrWhiteSpace(search)
                            ? "Chưa có khách hàng nào trong hệ thống."
                            : $"Không tìm thấy khách hàng phù hợp với \"{search}\".")
                    </p>
                }
                else
                {
                    <p class="admin-section-label">@Model.Count KHÁCH HÀNG</p>
                    <div class="table-wrapper">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Họ và tên</th>
                                    <th>Email</th>
                                    <th>Số điện thoại</th>
                                    <th>Ngày đăng ký</th>
                                    <th>Trạng thái</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var (user, index) in Model.Select((u, i) => (u, i + 1)))
                                {
                                    <tr class="@(user.IsActive ? "" : "row--locked")">
                                        <td class="col-index">@index</td>
                                        <td><strong>@user.FullName</strong></td>
                                        <td class="col-email">@user.Email</td>
                                        <td>@user.PhoneNumber</td>
                                        <td class="col-date">@user.CreatedAt.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            @if (user.IsActive)
                                            {
                                                <span class="status-badge status-badge--active">Hoạt động</span>
                                            }
                                            else
                                            {
                                                <span class="status-badge status-badge--locked">Đã khóa</span>
                                            }
                                        </td>
                                        <td>
                                            <form asp-action="ToggleLock" method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@user.Id" />
                                                <input type="hidden" name="returnSearch" value="@search" />
                                                <button type="submit"
                                                        class="button button--small @(user.IsActive ? "button--danger" : "button--success")"
                                                        onclick="return confirm('@(user.IsActive ? $"Bạn có chắc muốn KHÓA tài khoản của {user.FullName}?" : $"Bạn có chắc muốn MỞ KHÓA tài khoản của {user.FullName}?")')">
                                                    @(user.IsActive ? "Khóa tài khoản" : "Mở khóa")
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        </div>
    </div>
</section>
