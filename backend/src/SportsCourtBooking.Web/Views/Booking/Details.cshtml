@using System.Globalization
@using SportsCourtBooking.Application.DTOs
@using SportsCourtBooking.Domain.Enums
@model BookingDetailDto

@{
    ViewData["Title"] = $"Chi tiết đơn #{Model.Id}";
    var culture = CultureInfo.GetCultureInfo("vi-VN");

    var nowUtc = DateTime.UtcNow;
    var nowVietnam = nowUtc.AddHours(7);

    var canCancel =
        (
            Model.Status == BookingStatus.Pending
            || Model.Status == BookingStatus.Confirmed
        )
        && !Model.IsPaid
        && Model.BookingDate.ToDateTime(Model.StartTime) > nowVietnam
        && (
            Model.Status != BookingStatus.Pending
            || (
                Model.ExpiresAt.HasValue
                && Model.ExpiresAt.Value > nowUtc
            )
        );
}

<section class="page-section">
    <div class="shell shell--narrow">

        <div class="page-heading">
            <div>
                <h1>Chi tiết đơn #@Model.Id</h1>
                <p class="page-subtitle">@Model.CustomerName</p>
            </div>

            <a class="button button--outline"
               asp-controller="Booking"
               asp-action="My">
                Quay lại lịch đặt
            </a>
        </div>

        @if (Model.Status == BookingStatus.Cancelled)
        {
            if (Model.PaymentStatus == PaymentStatus.Refunded)
            {
                <div class="alert alert--info" style="margin-bottom: 20px; padding: 14px 18px; background: rgba(34, 197, 94, 0.1); border: 1px solid rgba(34, 197, 94, 0.3); border-radius: 8px; color: #166534;">
                    <strong>Thông báo hoàn tiền:</strong> Đơn đặt sân này đã được hủy và hoàn trả @((Model.RefundedAmount.HasValue && Model.RefundedAmount > 0 ? Model.RefundedAmount.Value : Model.TotalPrice).ToString("N0", culture))₫ thành công.
                </div>
            }
            else
            {
                <div class="alert alert--warning" style="margin-bottom: 20px; padding: 14px 18px; background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.3); border-radius: 8px; color: #92400e;">
                    <strong>Thông báo hủy đơn:</strong> Đơn đặt sân này đã được hủy. Khung giờ đã được mở lại.
                </div>
            }
        }

        <div class="booking-table-wrap">
            <table class="booking-table">
                <tbody>
                    <tr>
                        <th>Sân</th>
                        <td>@Model.CourtName</td>
                    </tr>

                    <tr>
                        <th>Địa điểm</th>
                        <td>@Model.Location</td>
                    </tr>

                    <tr>
                        <th>Ngày chơi</th>
                        <td>@Model.BookingDate.ToString("dd/MM/yyyy")</td>
                    </tr>

                    <tr>
                        <th>Khung giờ</th>
                        <td>
                            @Model.StartTime.ToString("HH:mm")
                            –
                            @Model.EndTime.ToString("HH:mm")
                        </td>
                    </tr>

                    <tr>
                        <th>Tạm tính</th>
                        <td>@((Model.TotalPrice + Model.DiscountAmount).ToString("N0", culture))₫</td>
                    </tr>

                    @if (!string.IsNullOrWhiteSpace(Model.VoucherCode))
                    {
                        <tr>
                            <th>Voucher (@Model.VoucherCode)</th>
                            <td>−@Model.DiscountAmount.ToString("N0", culture)₫</td>
                        </tr>
                    }

                    <tr>
                        <th>Tổng tiền</th>
                        <td>@Model.TotalPrice.ToString("N0", culture)₫</td>
                    </tr>

                    <tr>
                        <th>Trạng thái đơn</th>
                        <td>
                            <span class="status-badge @BookingStatusDisplay.CssClass(Model.Status)">
                                @BookingStatusDisplay.Label(Model.Status)
                            </span>
                        </td>
                    </tr>

                    <tr>
                        <th>Thanh toán</th>
                        <td>
                            @if (Model.PaymentStatus == PaymentStatus.Refunded)
                            {
                                <span style="color: #d97706; font-weight: 600;">Đã hoàn tiền (@((Model.RefundedAmount.HasValue && Model.RefundedAmount > 0 ? Model.RefundedAmount.Value : Model.TotalPrice).ToString("N0", culture))₫)</span>
                            }
                            else if (Model.IsPaid)
                            {
                                <span style="color: #16a34a; font-weight: 600;">Đã thanh toán</span>
                            }
                            else
                            {
                                <span>Chưa ghi nhận thanh toán</span>
                            }
                        </td>
                    </tr>

                    <tr>
                        <th>Thời điểm tạo đơn</th>
                        <td>
                            @Model.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")
                            (giờ Việt Nam)
                        </td>
                    </tr>

                    @if (Model.Status == BookingStatus.Pending
                        && Model.ExpiresAt.HasValue)
                    {
                        <tr>
                            <th>Hạn giữ chỗ</th>
                            <td>
                                @Model.ExpiresAt.Value.AddHours(7).ToString("dd/MM/yyyy HH:mm")
                                (giờ Việt Nam)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (canCancel)
{
    <div class="my-bookings-actions">
        <form asp-controller="Booking"
              asp-action="CancelMy"
              asp-route-id="@Model.Id"
              method="post"
              onsubmit="return confirm('Bạn chắc chắn muốn hủy đơn này? Khung giờ sẽ được mở lại cho người khác.');">

            @Html.AntiForgeryToken()

            <button class="button button--outline" type="submit">
                Hủy đơn đặt sân
            </button>
        </form>
    </div>
}
else if (Model.IsPaid)
{
    <p>
        Đơn đã thanh toán. Vui lòng liên hệ nhân viên
        để được hỗ trợ hủy và xử lý tiền.
    </p>
}

        <div class="my-bookings-actions">
            <div>
                <h2>Ghi chú</h2>
                <p>
                    @(string.IsNullOrWhiteSpace(Model.Note)
                        ? "Không có ghi chú."
                        : Model.Note)
                </p>
            </div>
        </div>

        @if (Model.CanReview)
        {
            <div class="review-booking-panel">
                <div>
                    <h2>@(Model.ReviewId.HasValue ? "Cập nhật đánh giá" : "Chia sẻ trải nghiệm")</h2>
                    <p>
                        @(Model.ReviewId.HasValue
                            ? $"Bạn đã đánh giá {Model.ReviewRating}/5 sao."
                            : "Khung giờ đã kết thúc. Hãy chia sẻ trải nghiệm của bạn về sân.")
                    </p>
                </div>
                <a class="button button--primary"
                   asp-action="Review"
                   asp-route-id="@Model.Id">
                    @(Model.ReviewId.HasValue ? "Sửa đánh giá" : "Viết đánh giá")
                </a>
            </div>
        }
        else if (Model.ReviewId.HasValue)
        {
            <div class="review-booking-panel">
                <div>
                    <h2>Đánh giá của bạn: @Model.ReviewRating/5 sao</h2>
                    <p>@(string.IsNullOrWhiteSpace(Model.ReviewComment) ? "Bạn chưa thêm nhận xét." : Model.ReviewComment)</p>
                </div>
            </div>
        }

    </div>
</section>