@using System.Globalization
@using SportsCourtBooking.Application.DTOs
@using SportsCourtBooking.Domain.Enums
@model BookingHistoryViewModel

@{
    ViewData["Title"] = "Lịch đặt của tôi";
    var culture = CultureInfo.GetCultureInfo("vi-VN");
}

<section class="page-section">
    <div class="shell shell--narrow">
        <div class="page-heading">
            <div>
                <p class="eyebrow eyebrow--dark"><span class="eyebrow-line"></span> TÀI KHOẢN CỦA BẠN</p>
                <h1>Lịch đặt của tôi</h1>
                <p class="page-subtitle">@User.Identity?.Name</p>
            </div>
            <a class="button button--outline" asp-controller="Home" asp-action="Index">Tìm sân</a>
        </div>

        <form class="booking-filter"
      asp-controller="Booking"
      asp-action="My"
      method="get">

    <label>
        Trạng thái

        <select name="status">
            <option value="">Tất cả trạng thái</option>

            @foreach (var status in Enum.GetValues<BookingStatus>())
            {
                <option value="@((int)status)"
                        selected="@(Model.Status == status)">
                    @BookingStatusDisplay.Label(status)
                </option>
            }
        </select>
    </label>

    <label>
        Từ ngày chơi

        <input type="date"
               name="fromDate"
               value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
    </label>

    <label>
        Đến ngày chơi

        <input type="date"
               name="toDate"
               value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
    </label>

    <button class="button button--small button--dark"
            type="submit">
        Lọc
    </button>

    <a class="text-link"
       asp-controller="Booking"
       asp-action="My">
        Xóa bộ lọc
    </a>
</form>

<p>Tìm thấy @Model.Bookings.Count đơn đặt sân.</p>

        @if (Model.Bookings.Count == 0)
        {
            <div class="empty-state" role="status">
                <span class="empty-state-icon" aria-hidden="true">▦</span>
                <h3>Không có đơn đặt sân phù hợp</h3>
                <p>Thử xóa bộ lọc hoặc chọn sân để tạo lịch đặt mới.</p>
                <a class="text-link" asp-controller="Home" asp-action="Index">Tìm sân ngay <span aria-hidden="true">↗</span></a>
            </div>
        }
        else
        {
            <div class="booking-table-wrap booking-history-table-wrap">
                <table class="booking-table booking-history-table">
                    <thead>
                        <tr>
                            <th>Ngày</th>
                            <th>Sân</th>
                            <th>Giờ</th>
                            <th>Tổng tiền</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var booking in Model.Bookings)
                        {
                            <tr>
                                <td data-label="Ngày">@booking.BookingDate.ToString("dd/MM/yyyy")</td>
                                <td data-label="Sân">@booking.CourtName</td>
                                <td data-label="Giờ">@booking.StartTime.ToString("HH:mm") – @booking.EndTime.ToString("HH:mm")</td>
                                <td data-label="Tổng tiền">@booking.TotalPrice.ToString("N0", culture)₫</td>
                                <td data-label="Trạng thái"><span class="status-badge @BookingStatusDisplay.CssClass(booking.Status)">@BookingStatusDisplay.Label(booking.Status)</span></td>
                                <td data-label="Thao tác">
                                    <a class="text-link" asp-controller="Booking" asp-action="Details" asp-route-id="@booking.Id">Xem chi tiết</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="my-bookings-actions">
            <form class="inline-form" asp-controller="Auth" asp-action="Logout" method="post">
                <button class="button button--outline button--small" type="submit">Đăng xuất</button>
            </form>
        </div>
    </div>
</section>
