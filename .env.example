# ===== PostgreSQL (database chính của ứng dụng) =====
# Không dùng các ký tự ; = $ trong mật khẩu (sẽ làm hỏng chuỗi kết nối / docker compose).
POSTGRES_DB=sportscourt
POSTGRES_USER=postgres
POSTGRES_PASSWORD=12345

# ===== pgAdmin (giao diện quản lý PostgreSQL, http://localhost:5050) =====
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=12345
